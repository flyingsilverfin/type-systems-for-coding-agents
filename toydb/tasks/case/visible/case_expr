# CASE expressions: the main happy path.

> CREATE TABLE t (id INT PRIMARY KEY, g STRING, v INT)
> INSERT INTO t VALUES (1, 'a', 10), (2, 'a', 20), (3, 'b', 30), (4, 'b', NULL)
---
ok

# The searched and the simple form. Without ELSE the result is NULL.
> SELECT id, CASE WHEN v >= 20 THEN 'high' WHEN v >= 10 THEN 'low' ELSE 'none' END, CASE g WHEN 'a' THEN 1 END FROM t
---
1, 'low', 1
2, 'high', 1
3, 'high', NULL
4, 'none', NULL

# Only the chosen branch is evaluated.
> SELECT CASE WHEN TRUE THEN 'ok' ELSE 1 / 0 END, CASE WHEN v IS NULL THEN 0 ELSE 60 / v END FROM t WHERE id > 2
---
'ok', 2
'ok', 0

# Inside and around aggregate functions.
> SELECT g, SUM(CASE WHEN v > 10 THEN 1 ELSE 0 END), CASE WHEN COUNT(*) > 1 THEN 'many' ELSE 'one' END FROM t GROUP BY g ORDER BY g
---
'a', 1, 'many'
'b', 1, 'many'

# The plan shows a CASE as it was written.
[plan]> SELECT CASE g WHEN 'a' THEN v + 1 ELSE 0 END FROM t WHERE id = 1
---
Projection: CASE t.g WHEN 'a' THEN t.v + 1 ELSE 0 END
└─ KeyLookup: t (1)
11

# A CASE needs at least one WHEN.
!> SELECT CASE 1 ELSE 2 END
---
Error: invalid input: expected token WHEN, found ELSE
