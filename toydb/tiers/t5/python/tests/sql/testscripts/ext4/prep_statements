# Joins and aggregates.
> CREATE TABLE u (id INT PRIMARY KEY, t_id INT, w INT)
> INSERT INTO u VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30)
> PREPARE agg (INT) AS SELECT t.v, SUM(u.w) FROM t JOIN u ON u.t_id = t.id WHERE u.w > $1 GROUP BY t.v HAVING SUM(u.w) > $1 ORDER BY t.v
> EXECUTE agg (10)
> EXECUTE agg (25)
---
'a', 20
'b', 30
'b', 30

