# EXECUTE runs the statement in the session's transaction, or in the implicit
# transaction the statement would use; prepared statements are not undone by
# ROLLBACK.
> PREPARE ins (INT, STRING) AS INSERT INTO t VALUES ($1, $2)
> PREPARE get (INT) AS SELECT v FROM t WHERE id = $1
a:> BEGIN
a:> PREPARE mine AS SELECT COUNT(*) FROM t
a:> INSERT INTO t VALUES (3, 'c')
a:> EXECUTE mine
a:> ROLLBACK
a:> EXECUTE mine
> BEGIN
> EXECUTE ins (4, 'd')
> EXECUTE get (4)
a:> EXECUTE mine
> ROLLBACK
> EXECUTE get (4)
