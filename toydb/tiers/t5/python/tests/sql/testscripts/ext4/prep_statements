# Every planned statement can be prepared, and runs as if it had been issued
# with the values in place of the parameters, also in transactions.

> CREATE TABLE t (id INT PRIMARY KEY, v STRING)
> INSERT INTO t VALUES (1, 'a'), (2, 'b')
---
ok

# CREATE TABLE and DROP TABLE, with a parameter in a DEFAULT.
> PREPARE mk (INT, STRING) AS CREATE TABLE x (id INT PRIMARY KEY, n INT DEFAULT $1, s STRING DEFAULT $2)
> EXECUTE mk (7, 'it''s')
!> EXECUTE mk (7, 'it''s')
> PREPARE rm AS DROP TABLE x
schema x
> EXECUTE rm
!> EXECUTE rm
---
Error: invalid input: table x already exists
CREATE TABLE x (
  id INTEGER PRIMARY KEY,
  n INTEGER DEFAULT 7,
  s STRING DEFAULT 'it\'s'
)
