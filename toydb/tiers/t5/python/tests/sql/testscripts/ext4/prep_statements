# In a read-only transaction, prepared writes fail like the statements do.
> BEGIN READ ONLY
> PREPARE ro (INT) AS DELETE FROM t WHERE id = $1
!> EXECUTE ro (1)
> EXECUTE get (1)
> COMMIT
---
Error: read-only transaction
'a'

# Concurrent prepared writes conflict like the statements.
a:> BEGIN
b:> BEGIN
a:> PREPARE up (STRING) AS UPDATE t SET v = $1 WHERE id = 1
b:> PREPARE up (STRING) AS UPDATE t SET v = $1 WHERE id = 1
a:> EXECUTE up ('x')
b:!> EXECUTE up ('y')
a:> COMMIT
b:> ROLLBACK
> EXECUTE get (1)
---
b: Error: serialization failure, retry transaction
'x'

