      └─ Projection: item.id, item.name, item.qty
         └─ Scan: item
2, 'pear'
{"result":"explain","plan":{"statement":"select","root":{"node":"remap","columns":[{"column":0,"label":"item.id"},{"column":1,"label":"item.name"}],"dropped":[{"column":2,"label":"item.qty"}],"source":{"node":"limit","limit":1,"source":{"node":"order","key":[{"expr":{"column":2,"label":"item.qty"},"direction":"asc"}],"source":{"node":"projection","expressions":[{"expr":{"column":0,"label":"item.id"},"alias":null},{"expr":{"column":1,"label":"item.name"},"alias":null},{"expr":{"column":3,"label":"item.qty"},"alias":null}],"source":{"node":"scan","table":"item","alias":null,"filter":null}}}}}}}

