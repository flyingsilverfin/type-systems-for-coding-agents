# IMPORT ... FROM JSON errors. Every line is read and checked first (its
# members in the order written), then the rows are inserted; the first error
# is reported and nothing is imported.

> CREATE TABLE t (id INT PRIMARY KEY, name STRING NOT NULL, score FLOAT, ok BOOLEAN)
> INSERT INTO t VALUES (1, 'ann', 1.0, TRUE)
---
ok

# Lines that are not JSON objects. NaN and Infinity are not JSON.
!> IMPORT INTO nosuch FROM JSON '{}'
!> IMPORT INTO t FROM JSON '{"id":2,"name":"b"}', '{"id":3'
!> IMPORT INTO t FROM JSON 'nope'
!> IMPORT INTO t FROM JSON '{"id":2,"name":"b"} {}'
!> IMPORT INTO t FROM JSON '{"id":2,"name":"b","score":NaN}'
!> IMPORT INTO t FROM JSON ''
!> IMPORT INTO t FROM JSON '[1, 2]'
!> IMPORT INTO t FROM JSON '{"id":2,"name":"b"}', 'null'
!> IMPORT INTO t FROM JSON '"text"'
!> IMPORT INTO t FROM JSON '{"id":2,"name":"\ud800"}'
---
