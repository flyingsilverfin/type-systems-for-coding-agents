# Quoted, they are ordinary names, and the schema display quotes them.
> CREATE TABLE "show" ("analyze" INT PRIMARY KEY, "csv" STRING, "json" STRING, "sql" BOOLEAN)
> INSERT INTO "show" VALUES (1, 'a', 'b', TRUE)
> SELECT "show"."csv", "json" AS "export" FROM "show"
schema
---
'a', 'b'
CREATE TABLE "show" (
  "analyze" INTEGER PRIMARY KEY,
  "csv" STRING DEFAULT NULL,
  "json" STRING DEFAULT NULL,
  "sql" BOOLEAN DEFAULT NULL
)

# Names that merely contain the keywords are unaffected.
> CREATE TABLE shows (sqlite INT PRIMARY KEY, csv_file STRING, exported BOOLEAN)
> INSERT INTO shows VALUES (1, 'x', FALSE)
> SELECT * FROM shows
---
1, 'x', FALSE

# The extension statements work on quoted names, and the extension outputs
# write such names as stored (digests and SQL quote them).
> ANALYZE "show"
> SHOW STATISTICS "show"
> EXPORT "show" AS CSV
> EXPORT "show" AS SQL
