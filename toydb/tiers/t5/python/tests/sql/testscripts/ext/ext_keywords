# The extension keywords ANALYZE, CSV, EXPORT, IMPORT, JSON, SHOW, SQL,
# STATEMENTS and STATISTICS are reserved like the other keywords.

!> CREATE TABLE analyze (id INT PRIMARY KEY)
!> CREATE TABLE t (id INT PRIMARY KEY, csv STRING)
!> CREATE TABLE export (id INT PRIMARY KEY)
!> CREATE TABLE import (id INT PRIMARY KEY)
!> CREATE TABLE t (json STRING PRIMARY KEY)
!> CREATE TABLE show (id INT PRIMARY KEY)
!> SELECT 1 AS sql
!> SELECT 1 AS Statements
!> CREATE TABLE t (id INT PRIMARY KEY, STATISTICS INT)
