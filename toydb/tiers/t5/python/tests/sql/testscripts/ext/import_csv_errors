# IMPORT ... FROM CSV errors. All lines are read and checked first (line 1 is
# the header), then the rows are inserted; the first error is reported and
# nothing is imported.

> CREATE TABLE t (id INT PRIMARY KEY, name STRING NOT NULL, score FLOAT, ok BOOLEAN)
> INSERT INTO t VALUES (1, 'ann', 1.0, TRUE)
---
ok

# The table and the header.
!> IMPORT INTO nosuch FROM CSV 'id'
!> IMPORT INTO t FROM CSV 'id,nope', '2,x'
!> IMPORT INTO t FROM CSV 'ID,name', '2,x'
!> IMPORT INTO t FROM CSV 'id,name,id', '2,x,2'
---
Error: invalid input: table nosuch does not exist
Error: invalid input: unknown column nope in table t
Error: invalid input: unknown column ID in table t
Error: invalid input: column id given multiple times

