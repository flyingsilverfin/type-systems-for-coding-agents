# Conditions can use every kind of expression, and refer to the columns
# qualified by the table name.
> CREATE TABLE item (id INT PRIMARY KEY, name STRING NOT NULL, price FLOAT, CHECK (item.price IS NULL OR price > 0.0 AND price < 1e6), CHECK (NOT name LIKE '% %'), CHECK (sqrt(id) < 10))
