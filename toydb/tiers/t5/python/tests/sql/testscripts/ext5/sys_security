# System tables of users and security: users, memberships, grants, check
# constraints, policies, and the audit log.

> CREATE USER alice PASSWORD 'pw'
> CREATE USER bob SUPERUSER
> CREATE USER staff
> GRANT staff TO alice
> GRANT alice TO bob
> CREATE TABLE t (id INT PRIMARY KEY, n INT, CHECK (n > 0), CONSTRAINT small CHECK (n < 10 AND n != 5))
> CREATE TABLE u (id INT PRIMARY KEY, CHECK (id != 0))
> GRANT SELECT, DELETE ON t TO staff
> GRANT SELECT ON u TO bob
> CREATE POLICY pu ON t TO staff USING (n > 1) WITH CHECK (n < 5)
> CREATE POLICY pa ON t USING (id = 1)
> SELECT * FROM toydb_users
> SELECT * FROM toydb_members
> SELECT * FROM toydb_grants
