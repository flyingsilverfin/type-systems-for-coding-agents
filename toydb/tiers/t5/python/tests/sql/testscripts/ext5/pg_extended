# Describe of a statement describes it with every parameter replaced by NULL;
# Describe of a portal describes the bound statement. Types are those of
# DESCRIBE, text for an unknown type.
pg parse name=s2 "SELECT $1 + 1, v, $2 FROM t WHERE id = 1" types="23,25"
pg describe statement=s2
pg bind portal=p2 statement=s2 params="41,x"
pg describe portal=p2
pg execute portal=p2
pg sync
