# The extended query protocol: Parse, Bind, Describe, Execute, Close and
# Sync. Responses are printed when the runner sends Sync.

> CREATE TABLE t (id INT PRIMARY KEY, v STRING)
> INSERT INTO t VALUES (1, 'a'), (2, 'b'), (3, 'c')
pg startup
