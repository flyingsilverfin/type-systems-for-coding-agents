# FROM STDIN: the data is split into lines and fields, \N is NULL, escapes are
# undone, and each field is read by its column's type. The columns that are
# not listed get their defaults.
pg copy "COPY t (id, s, f) FROM STDIN" data="4\tfour\t2\n5\t\\N\tinf\n6\tsix\\\\x\t-1e3"
pg copy "COPY t FROM STDIN" data=""
pg query "SELECT * FROM t WHERE id > 3"
