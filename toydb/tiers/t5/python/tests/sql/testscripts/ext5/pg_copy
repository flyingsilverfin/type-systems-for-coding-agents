# COPY: a command of the PostgreSQL connection that sends a table's rows to
# the client, or inserts the rows the client sends, in PostgreSQL's text
# format. COPY is not a toydb keyword.

> CREATE TABLE t (id INT PRIMARY KEY, b BOOLEAN, f FLOAT, s STRING DEFAULT 'd')
> INSERT INTO t VALUES (1, TRUE, 1.5, 'a b'), (2, NULL, NAN, 'x\y'), (3, FALSE, -0.5, '')
> CREATE TABLE copy (id INT PRIMARY KEY)
> CREATE USER alice
pg startup
