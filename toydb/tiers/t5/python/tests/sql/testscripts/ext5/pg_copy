# Errors: invalid data, the checks of the inserted rows, CopyFail, and the
# command's own syntax and names. A failing COPY inserts nothing.
pg copy "COPY t FROM STDIN" data="7\tt\t1\ts\n8\tyes\t1\tz\n"
pg copy "COPY t FROM STDIN" data="9\tt\n"
pg copy "COPY t (id) FROM STDIN" data="10\n1\n"
pg copy "COPY t (id) FROM STDIN" fail="client gave up"
pg query "COPY t TO stdin"
pg query "COPY t FROM STDOUT"
