# The change log in a cluster: every node records the changes as it applies the
# Raft log, so every client sees the same log, in commit order.

cluster nodes=3
---
ok

c1:> CREATE TABLE t (id INT PRIMARY KEY, v STRING)
c2:> INSERT INTO t VALUES (1, 'a'), (2, 'b')
c3:> UPDATE t SET v = 'c' WHERE id = 2
c1:> SHOW CHANGES
c3:[header]> SHOW CHANGES SINCE 2
---
c1: 1, 't', 'create_table', NULL, 'CREATE TABLE t (id INTEGER PRIMARY KEY, v STRING DEFAULT NULL)'
c1: 2, 't', 'insert', 1, '{\"id\":1,\"v\":\"a\"}'
c1: 2, 't', 'insert', 2, '{\"id\":2,\"v\":\"b\"}'
c1: 3, 't', 'update', 2, '{\"id\":2,\"v\":\"c\"}'
c3: version, table, op, key, data
c3: 3, 't', 'update', 2, '{\"id\":2,\"v\":\"c\"}'

# Uncommitted changes are not shown, committed ones in commit order.
c1:> BEGIN
c2:> BEGIN
c1:> DELETE FROM t WHERE id = 1
c2:> CREATE VIEW vt AS SELECT v FROM t
c2:> SHOW CHANGES SINCE 3
c2:> COMMIT
c3:> SHOW CHANGES SINCE 3
c1:> COMMIT
c2:> SHOW CHANGES SINCE 3
---
c3: 5, 'vt', 'create_view', NULL, 'CREATE VIEW vt (v) AS SELECT v FROM t'
c2: 5, 'vt', 'create_view', NULL, 'CREATE VIEW vt (v) AS SELECT v FROM t'
c2: 4, 't', 'delete', 1, NULL

# ANALYZE and DROP are recorded too; a rolled-back transaction is not.
c3:> BEGIN
c3:> INSERT INTO t VALUES (9, 'z')
c3:> ROLLBACK
c1:> ANALYZE t
c2:> DROP VIEW vt
c3:[json]> SHOW CHANGES SINCE 5
---
c3: {"result":"select","columns":["version","table","op","key","data"],"rows":[[7,"t","analyze",null,null],[8,"vt","drop_view",null,null]]}
