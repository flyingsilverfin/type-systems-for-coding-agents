# EXPORT AS SQL writes the views after the tables, each after the views it
# depends on; statement digests record the view statements.

> CREATE TABLE item (id INT PRIMARY KEY, name STRING, qty INT)
> INSERT INTO item VALUES (1, 'it''s', 10), (2, 'b', 3)
> CREATE VIEW b_view AS SELECT id, name FROM item WHERE qty > 5
> CREATE VIEW a_view AS SELECT * FROM b_view
> CREATE VIEW "Mixed" ("Id", n) AS SELECT id, name FROM item
> CREATE VIEW c_view AS SELECT a.id FROM a_view a JOIN "Mixed" m ON m."Id" = a.id
> EXPORT AS SQL
---
CREATE TABLE item (
  id INTEGER PRIMARY KEY,
  name STRING DEFAULT NULL,
  qty INTEGER DEFAULT NULL
);
INSERT INTO item VALUES (1, 'it''s', 10);
INSERT INTO item VALUES (2, 'b', 3);
CREATE VIEW "Mixed" ("Id", n) AS SELECT id, name FROM item;
CREATE VIEW b_view (id, name) AS SELECT id, name FROM item WHERE qty > 5;
CREATE VIEW a_view (id, name) AS SELECT * FROM b_view;
CREATE VIEW c_view (id) AS SELECT a.id FROM a_view AS a JOIN "Mixed" AS m ON m."Id" = a.id;

