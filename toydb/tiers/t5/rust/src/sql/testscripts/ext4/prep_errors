# The keywords are reserved.
!> CREATE TABLE prepare (id INT PRIMARY KEY)
!> CREATE TABLE execute (id INT PRIMARY KEY)
!> CREATE TABLE deallocate (id INT PRIMARY KEY)
!> SELECT 1 AS prepared
> PREPARE "prepare" AS SELECT 1
> EXECUTE "prepare"
---
