# Parameters outside prepared statements, parse errors, PREPARE checks,
# keywords, digests and JSON.

> CREATE TABLE t (id INT PRIMARY KEY, v STRING)
> INSERT INTO t VALUES (1, 'a')
---
ok

# A statement with a parameter can only be prepared; the smallest parameter
# number is reported. FORMAT and LINT accept parameters.
!> SELECT $1
!> INSERT INTO t VALUES ($2, $1)
!> SELECT * FROM t WHERE id = $01
!> EXPLAIN SELECT $3
!> DESCRIBE SELECT $1
!> ESTIMATE SELECT $1
!> CREATE VIEW v AS SELECT $1 AS a
!> DESCRIBE BEGIN READ ONLY
> FORMAT SELECT $1
---
Error: invalid input: parameter $1 can only be used in a prepared statement
Error: invalid input: parameter $1 can only be used in a prepared statement
Error: invalid input: parameter $1 can only be used in a prepared statement
Error: invalid input: parameter $3 can only be used in a prepared statement
Error: invalid input: parameter $1 can only be used in a prepared statement
Error: invalid input: parameter $1 can only be used in a prepared statement
Error: invalid input: parameter $1 can only be used in a prepared statement
Error: invalid input: DESCRIBE is not supported for BEGIN
