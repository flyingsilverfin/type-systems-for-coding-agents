# Table privileges: GRANT and REVOKE, and the privilege check of every
# statement against the session's current user.

> CREATE TABLE t (id INT PRIMARY KEY, v STRING)
> INSERT INTO t VALUES (1, 'a'), (2, 'b')
> CREATE VIEW tv AS SELECT v FROM t WHERE id = 1
> CREATE USER alice
> CREATE USER bob
---
ok

# Without privileges, alice can do nothing with t or tv.
a:> SET ROLE alice
a:!> SELECT * FROM t
a:!> SELECT * FROM tv
a:!> INSERT INTO t VALUES (3, 'c')
a:!> UPDATE t SET v = 'x'
a:!> DELETE FROM t WHERE id = 1
---
a: Error: permission denied: user alice has no SELECT privilege on t
a: Error: permission denied: user alice has no SELECT privilege on tv
a: Error: permission denied: user alice has no INSERT privilege on t
a: Error: permission denied: user alice has no UPDATE privilege on t
a: Error: permission denied: user alice has no DELETE privilege on t

