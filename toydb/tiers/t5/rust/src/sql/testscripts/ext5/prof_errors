# The statement's errors, and a failing write changes nothing.
> CREATE TABLE z (id INT PRIMARY KEY)
> INSERT INTO z VALUES (1), (2), (3)
!> EXPLAIN (ANALYZE) SELECT * FROM nosuch
!> EXPLAIN (ANALYZE) SELECT 1 / 0
!> EXPLAIN (ANALYZE) INSERT INTO z VALUES (4), (1)
> SELECT count(*) FROM z
---
Error: invalid input: table nosuch does not exist
Error: invalid input: can't divide by zero
Error: invalid input: primary key 1 already exists
3

# Every node runs to completion, so a row that the statement itself would
# never reach can fail.
> SELECT 1 / (id - 2) FROM z LIMIT 1
!> EXPLAIN (ANALYZE) SELECT 1 / (id - 2) FROM z LIMIT 1
> EXPLAIN (ANALYZE) SELECT 1 / (id - 2) FROM z WHERE id != 2 LIMIT 1
---
