'ESTIMATE CREATE TABLE t (id INTEGER PRIMARY KEY, CHECK (nosuch > ?))', 1, 0, 1
'DESCRIBE CREATE TABLE t (id INTEGER PRIMARY KEY, CHECK (nosuch > ?))', 1, 0, 0
'EXPLAIN CREATE TABLE t (id INTEGER PRIMARY KEY, CHECK (nosuch > ?))', 1, 0, 0
'SELECT * FROM t', 1, 1, 0
'LINT CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER, s STRING, CHECK (n = ?), CHECK (n / ? > ?), CHECK (? = ?), CHECK (s = ? AND s LIKE ?))', 1, 0, 3
