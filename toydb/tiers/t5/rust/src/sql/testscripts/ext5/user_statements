a:!> DESCRIBE SELECT v FROM t
a:!> ESTIMATE DELETE FROM t
a:> EXPLAIN SELECT * FROM u
a:[header]> DESCRIBE t
a:> FORMAT update t set v = 'x'
a:> LINT DELETE FROM t
a:> PREPARE get (INT) AS SELECT v FROM t WHERE id = $1
---
