# Creating requires nothing: alice owns what she creates. A reference to
# another table is not an access.
a:> CREATE TABLE mine (id INT PRIMARY KEY, t_id INT REFERENCES t)
a:> INSERT INTO mine VALUES (1, 1)
a:!> INSERT INTO mine VALUES (2, 2)
a:!> CREATE VIEW mv AS SELECT * FROM t
a:> CREATE VIEW mv AS SELECT id FROM mine
a:> SELECT * FROM mv
