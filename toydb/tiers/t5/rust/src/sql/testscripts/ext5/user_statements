# What each statement requires: the privileges of its accesses, in the order
# of the statement's text, then its own requirement.

> CREATE TABLE t (id INT PRIMARY KEY, v STRING)
> CREATE TABLE u (id INT PRIMARY KEY, t_id INT REFERENCES t)
> INSERT INTO t VALUES (1, 'a')
> INSERT INTO u VALUES (10, 1)
> CREATE USER alice
> GRANT SELECT ON u TO alice
a:> SET ROLE alice
---
ok

# Every table and view of the FROM clause is checked, left to right; a name
# that is neither a table nor a view isn't checked.
a:> SELECT * FROM u
a:!> SELECT * FROM u JOIN t ON u.t_id = t.id
a:!> SELECT * FROM t JOIN u ON u.t_id = t.id
a:!> SELECT * FROM nosuch JOIN t ON TRUE
a:!> SELECT * FROM u, nosuch
---
a: 10, 1
a: Error: permission denied: user alice has no SELECT privilege on t
a: Error: permission denied: user alice has no SELECT privilege on t
a: Error: permission denied: user alice has no SELECT privilege on t
a: Error: invalid input: table nosuch does not exist

# The privilege check comes before the statement's own errors.
a:!> SELECT nosuch FROM t
a:!> INSERT INTO t VALUES ('x')
a:!> UPDATE t SET nosuch = 1
a:> DROP TABLE IF EXISTS nosuch
---
a: Error: permission denied: user alice has no SELECT privilege on t
a: Error: permission denied: user alice has no INSERT privilege on t
a: Error: permission denied: user alice has no UPDATE privilege on t

# EXPLAIN, DESCRIBE and ESTIMATE of a statement require what the statement
# requires; DESCRIBE of a name, FORMAT, LINT and PREPARE require nothing.
