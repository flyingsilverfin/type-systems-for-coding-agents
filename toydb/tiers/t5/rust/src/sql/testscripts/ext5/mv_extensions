# Materialized views in the other extensions: EXPORT AS SQL, SHOW VIEWS,
# system tables, DESCRIBE, ESTIMATE, EXPLAIN, FORMAT, LINT, digests, the
# change log (which doesn't record them), backups.

> CREATE TABLE t (id INT PRIMARY KEY, v INT)
> INSERT INTO t VALUES (1, 10), (2, 20), (3, 30)
> CREATE VIEW tv AS SELECT id, v FROM t WHERE v > 10
> CREATE MATERIALIZED VIEW mv (k, w) AS SELECT id, v * 2 FROM tv
> CREATE VIEW over AS SELECT k FROM mv
> EXPORT AS SQL
> SHOW VIEWS
> SELECT * FROM toydb_matviews
---
CREATE TABLE t (
  id INTEGER PRIMARY KEY,
  v INTEGER DEFAULT NULL
);
INSERT INTO t VALUES (1, 10);
INSERT INTO t VALUES (2, 20);
INSERT INTO t VALUES (3, 30);
CREATE VIEW tv (id, v) AS SELECT id, v FROM t WHERE v > 10;
CREATE MATERIALIZED VIEW mv (k, w) AS SELECT id, v * 2 FROM tv;
CREATE VIEW over (k) AS SELECT k FROM mv;
'over', 'k', 'SELECT k FROM mv'
'tv', 'id, v', 'SELECT id, v FROM t WHERE v > 10'
'mv', 'admin', 'k, w', 'SELECT id, v * 2 FROM tv', 'tv', 2

