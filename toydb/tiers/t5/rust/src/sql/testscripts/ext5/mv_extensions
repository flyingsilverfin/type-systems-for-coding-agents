# A backup has a MATVIEW record, in dependency order with the views; a
# restore executes its query, so its rows are those of the restored tables
# even if it was stale.
> INSERT INTO t VALUES (4, 40)
> SELECT * FROM mv
backup b
backup-list b
> DROP VIEW over
> DROP MATERIALIZED VIEW mv
> DROP VIEW tv
> DROP TABLE t
restore b
> SELECT * FROM mv
