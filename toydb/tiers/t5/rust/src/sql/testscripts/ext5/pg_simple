ReadyForQuery idle
CommandComplete UPDATE 1
CommandComplete DELETE 1
RowDescription id int8(20,8), v text(25,-1)
DataRow '2', 'c'
CommandComplete SELECT 1
ReadyForQuery idle

# Empty statements are skipped; a query without statements gets
# EmptyQueryResponse. A ; inside a string doesn't split.
pg query ""
pg query " ; ;"
pg query "SELECT 1; ; SELECT 'it''s; one';"
---
EmptyQueryResponse
ReadyForQuery idle
EmptyQueryResponse
ReadyForQuery idle
RowDescription ?column? int8(20,8)
DataRow '1'
CommandComplete SELECT 1
RowDescription ?column? text(25,-1)
DataRow 'it\'s; one'
CommandComplete SELECT 1
ReadyForQuery idle

# Errors: the statements after the first failing one are not executed. Text
# that can't be tokenized executes nothing.
pg query "INSERT INTO t VALUES (3, 'x'); SELECT nosuch FROM t; INSERT INTO t VALUES (4, 'y')"
pg query "SELECT count(*) FROM t"
pg query "INSERT INTO t VALUES (5, 'z'); SELECT 'unterminated"
pg query "SELECT FROM t"
pg query "SELECT count(*) FROM t"
---
CommandComplete INSERT 0 1
ErrorResponse ERROR 42000 invalid input: unknown column nosuch
ReadyForQuery idle
RowDescription count int8(20,8)
DataRow '2'
CommandComplete SELECT 1
ReadyForQuery idle
ErrorResponse ERROR 42000 invalid input: unexpected end of string literal
ReadyForQuery idle
ErrorResponse ERROR 42000 invalid input: expected expression atom, found FROM
ReadyForQuery idle
RowDescription count int8(20,8)
DataRow '2'
CommandComplete SELECT 1
ReadyForQuery idle

# Transactions: ReadyForQuery shows the transaction status.
pg query "BEGIN; INSERT INTO t VALUES (6, 'w')"
pg query "SELECT count(*) FROM t"
a:> SELECT count(*) FROM t
pg query "ROLLBACK"
pg query "BEGIN READ ONLY; INSERT INTO t VALUES (7, 'q')"
pg query "COMMIT"
---
CommandComplete BEGIN
CommandComplete INSERT 0 1
ReadyForQuery transaction
RowDescription count int8(20,8)
DataRow '3'
CommandComplete SELECT 1
ReadyForQuery transaction
a: 2
CommandComplete ROLLBACK
ReadyForQuery idle
CommandComplete BEGIN
ErrorResponse ERROR 25006 read-only transaction
ReadyForQuery transaction
CommandComplete COMMIT
ReadyForQuery idle

# Command tags of the other statements: their statement names.
pg query "CREATE TABLE u (id INT PRIMARY KEY); CREATE VIEW tv AS SELECT v FROM t; DROP VIEW tv; DROP TABLE u; DROP TABLE IF EXISTS u"
pg query "ANALYZE t; PREPARE p AS SELECT 1; EXECUTE p; DEALLOCATE p; CREATE USER x; GRANT SELECT ON t TO x; REVOKE SELECT ON t FROM x; DROP USER x"
pg query "IMPORT INTO t FROM CSV 'id,v', '8,i'"
