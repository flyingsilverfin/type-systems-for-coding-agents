# EXPLAIN, FORMAT and EXPORT return their lines as rows of one text column;
# the other statements that return rows return them as query results.
pg query "EXPLAIN SELECT v FROM t WHERE id = 2"
pg query "FORMAT select 1 from t where id = 2"
pg query "EXPORT t AS CSV"
pg query "SHOW VIEWS"
pg query "DESCRIBE t"
