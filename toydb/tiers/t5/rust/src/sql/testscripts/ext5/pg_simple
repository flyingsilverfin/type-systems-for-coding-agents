# Simple query: a Query message may hold several statements, each executed as
# if sent alone; the first error ends it. Each result has its messages and
# command tag.

> CREATE TABLE t (id INT PRIMARY KEY, v STRING)
pg startup
---
AuthenticationOk
ParameterStatus application_name= client_encoding=UTF8 DateStyle=ISO integer_datetimes=on is_superuser=on server_encoding=UTF8 server_version=14.0 session_authorization=admin standard_conforming_strings=on
BackendKeyData
ReadyForQuery idle

pg query "INSERT INTO t VALUES (1, 'a'), (2, 'b')"
pg query "SELECT * FROM t"
pg query "UPDATE t SET v = 'c' WHERE id = 2; DELETE FROM t WHERE id = 1; SELECT * FROM t"
---
CommandComplete INSERT 0 2
ReadyForQuery idle
