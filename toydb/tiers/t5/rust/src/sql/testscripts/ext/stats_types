# Column statistics for every data type: NaN and infinities, Unicode strings,
# booleans, ties, all-NULL columns and empty tables. Values are compared and
# grouped as ORDER BY and GROUP BY do.

> CREATE TABLE f (id INT PRIMARY KEY, x FLOAT, s STRING, z INT)
> INSERT INTO f VALUES (1, NAN, '', NULL), (2, INFINITY, 'é', NULL), (3, -INFINITY, '👋👋', NULL), (4, 0.0, 'abc', NULL), (5, NAN, 'abc', NULL), (6, -0.0, NULL, NULL)
> ANALYZE f
---
ok

# NaN is one distinct value and sorts after infinity; 0.0 and the stored -0.0
# are the same value, and the tie with NaN goes to the smaller 0.0. Lengths
# count characters, not bytes. A column of only NULLs has no min, max or top.
> SHOW STATISTICS f
---
'id', 6, 0, 6, 1, 6, 1, 1, NULL
'x', 6, 0, 4, -inf, NaN, 0.0, 2, NULL
's', 6, 1, 4, '', '👋👋', 'abc', 2, 1.8
'z', 6, 6, 0, NULL, NULL, NULL, NULL, NULL

[json]> SHOW STATISTICS f
---
