# Booleans and ties: the smallest of the most common values is the top.
# Strings compare by code points ('B' < 'a').
> CREATE TABLE b (id INT PRIMARY KEY, flag BOOLEAN, i INT, s STRING)
> INSERT INTO b VALUES (1, TRUE, -5, 'b'), (2, FALSE, 3, 'a'), (3, TRUE, 3, 'b'), (4, FALSE, -5, 'a'), (5, NULL, 7, 'B')
> ANALYZE b
> SHOW STATISTICS b
---
'id', 5, 0, 5, 1, 5, 1, 1, NULL
'flag', 5, 1, 2, FALSE, TRUE, FALSE, 2, NULL
'i', 5, 0, 3, -5, 7, -5, 2, NULL
's', 5, 0, 3, 'B', 'b', 'a', 2, 1.0

# An analyzed empty table has row and NULL counts of 0, unlike a table that was
# never analyzed.
> CREATE TABLE e (id INT PRIMARY KEY, s STRING)
> CREATE TABLE never (id INT PRIMARY KEY)
> ANALYZE e
> SHOW STATISTICS e
> SHOW STATISTICS never
---
'id', 0, 0, 0, NULL, NULL, NULL, NULL, NULL
's', 0, 0, 0, NULL, NULL, NULL, NULL, NULL
'id', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL

# Column names are shown as stored, also names that need quotes in SQL.
> CREATE TABLE "Odd" ("from" INT PRIMARY KEY, "a b" STRING)
> INSERT INTO "Odd" VALUES (1, 'x y z')
> ANALYZE "Odd"
> SHOW STATISTICS "Odd"
---
'from', 1, 0, 1, 1, 1, 1, 1, NULL
'a b', 1, 0, 1, 'x y z', 'x y z', 'x y z', 1, 5.0
