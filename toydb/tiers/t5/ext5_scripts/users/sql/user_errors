# FORMAT: one line each, names quoted to read back, literals as written.
> FORMAT create user Bob password 'it''s' superuser
> FORMAT drop user if exists "Bob"
> FORMAT grant select, insert, select on T to "role"
> FORMAT revoke delete on t from alice
> FORMAT grant staff to alice
> FORMAT revoke staff from alice
> FORMAT set role alice
> FORMAT reset role
> FORMAT show users
> FORMAT show grants
---
CREATE USER bob PASSWORD 'it''s' SUPERUSER
DROP USER IF EXISTS "Bob"
GRANT SELECT, INSERT, SELECT ON t TO "role"
REVOKE DELETE ON t FROM alice
GRANT staff TO alice
REVOKE staff FROM alice
SET ROLE alice
RESET ROLE
SHOW USERS
SHOW GRANTS

