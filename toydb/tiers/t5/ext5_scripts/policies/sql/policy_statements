# Policies restrict every read of a protected table's rows: scans, key and
# index lookups, joins, views, aggregates, UPDATE, DELETE and EXPORT. The
# checks of written rows see every row.

> CREATE TABLE doc (id INT PRIMARY KEY, owner_name STRING INDEX, body STRING)
> INSERT INTO doc VALUES (1, 'alice', 'a1'), (2, 'bob', 'b1'), (3, 'alice', 'a2')
> CREATE VIEW dv AS SELECT id, body FROM doc
> CREATE USER alice
> GRANT SELECT, INSERT, UPDATE, DELETE ON doc TO alice
> GRANT SELECT ON dv TO alice
> CREATE POLICY own ON doc TO alice USING (owner_name = 'alice')
a:> SET ROLE alice
