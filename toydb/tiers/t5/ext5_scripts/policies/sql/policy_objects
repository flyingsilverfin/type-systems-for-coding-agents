# Policies and other objects: DROP TABLE drops them, a user that a policy
# names can't be dropped, plans and estimates don't change, EXPORT AS SQL
# doesn't export them but exports only the rows the user reads.

> CREATE TABLE t (id INT PRIMARY KEY, v STRING)
> INSERT INTO t VALUES (1, 'a'), (2, 'b'), (3, 'c')
> CREATE USER alice
> CREATE USER bob
> GRANT SELECT ON t TO alice
> CREATE POLICY pa ON t TO alice USING (id != 2)
> CREATE POLICY pb ON t TO bob USING (id = 2)
!> DROP USER bob
!> DROP USER alice
> DROP POLICY pb ON t
> DROP USER bob
---
