3, 30

# Plans read the stored rows through a MaterializedView node; conditions stay
# above it.
[plan]> SELECT total FROM mv WHERE s = 'a'
[plan]> SELECT x."key" FROM m2 AS x JOIN t ON x."key" = t.id
---
Projection: mv.total
└─ Filter: mv.s = 'a'
   └─ MaterializedView: mv
40
Projection: x.key
└─ HashJoin: inner on x.key = t.id
   ├─ MaterializedView: m2 as x
   └─ Scan: t
3
2
1

# Views and materialized views can use each other.
> CREATE VIEW big AS SELECT s FROM mv WHERE total > 50
> CREATE MATERIALIZED VIEW keys AS SELECT * FROM big
> SELECT * FROM keys
> CREATE MATERIALIZED VIEW none AS SELECT * FROM t WHERE FALSE
> SELECT count(*) FROM none
---
'b'
0

