# Materialized views: the rows of a query, stored when the materialized view
# is created and when it is refreshed.

> CREATE TABLE t (id INT PRIMARY KEY, v INT, s STRING)
> INSERT INTO t VALUES (1, 10, 'a'), (2, 20, 'b'), (3, 30, 'a')
[json]> CREATE MATERIALIZED VIEW mv AS SELECT s, sum(v) AS total FROM t GROUP BY s ORDER BY s
> SELECT * FROM mv
> INSERT INTO t VALUES (4, 40, 'b')
> SELECT * FROM mv
[json]> REFRESH MATERIALIZED VIEW mv
> SELECT * FROM mv
[header]> SELECT m.s, m.total FROM mv AS m WHERE m.total > 40
---
{"result":"create_materialized_view","view":"mv","count":2}
'a', 40
'b', 20
'a', 40
'b', 20
{"result":"refresh_materialized_view","view":"mv","count":2}
'a', 40
'b', 60
m.s, m.total
'b', 60

# A column list names the columns; the rows keep the order of the query.
> CREATE MATERIALIZED VIEW m2 ("key", n) AS SELECT id, v FROM t WHERE id < 4 ORDER BY v DESC
[header]> SELECT * FROM m2
> SELECT t.id, mv.total FROM t JOIN mv ON t.s = mv.s ORDER BY t.id
> SELECT count(*), max(n) FROM m2
