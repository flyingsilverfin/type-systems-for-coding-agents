# Ownership and privileges: the creator owns a materialized view; reading it
# requires SELECT on it, refreshing and dropping it ownership. Its rows are
# computed by the refreshing user, with that user's policies.

> CREATE TABLE t (id INT PRIMARY KEY, owner_name STRING)
> INSERT INTO t VALUES (1, 'alice'), (2, 'bob')
> CREATE USER alice
> CREATE USER bob
> GRANT SELECT ON t TO alice
> CREATE POLICY own ON t TO alice USING (owner_name = 'alice')
a:> SET ROLE alice
b:> SET ROLE bob
a:> CREATE MATERIALIZED VIEW am AS SELECT id FROM t
a:> SELECT * FROM am
b:!> SELECT * FROM am
a:> GRANT SELECT ON am TO bob
b:> SELECT * FROM am
b:!> REFRESH MATERIALIZED VIEW am
b:!> DROP MATERIALIZED VIEW am
b:!> CREATE MATERIALIZED VIEW bm AS SELECT id FROM t
