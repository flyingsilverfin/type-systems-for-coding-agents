# REFRESH plans and executes the stored query again; when that fails, the
# stored rows stay.
> CREATE TABLE z (id INT PRIMARY KEY, d INT)
> INSERT INTO z VALUES (1, 1), (2, 5)
> CREATE MATERIALIZED VIEW mz AS SELECT id, 10 / d AS q FROM z
> INSERT INTO z VALUES (3, 0)
!> REFRESH MATERIALIZED VIEW mz
> SELECT * FROM mz
> DELETE FROM z WHERE id = 3
> REFRESH MATERIALIZED VIEW mz
> SELECT * FROM mz
---
Error: invalid input: can't divide by zero
1, 10
2, 2
1, 10
2, 2

# A materialized view's column names are checked like a view's.
!> CREATE MATERIALIZED VIEW bad AS SELECT 10 / d FROM z
!> CREATE MATERIALIZED VIEW bad (a) AS SELECT id, d FROM z
!> CREATE MATERIALIZED VIEW bad AS SELECT id, d AS id FROM z
---
