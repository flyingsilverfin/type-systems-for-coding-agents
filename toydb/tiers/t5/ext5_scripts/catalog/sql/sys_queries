# System tables in queries and views, and name resolution: a table or view of
# the same name comes first. Only queries can read them.

> CREATE TABLE emp (id INT PRIMARY KEY, name STRING, dept STRING)
> CREATE TABLE dept (id STRING PRIMARY KEY)
> CREATE VIEW wide AS SELECT table_name, count(*) AS n FROM toydb_columns GROUP BY table_name
> SELECT * FROM wide ORDER BY n DESC
> SELECT c.name FROM emp AS e JOIN toydb_columns AS c ON c.table_name = 'emp' AND c.name = e.name
> SHOW VIEWS
---
'emp', 3
'dept', 1
'wide', 'table_name, n', 'SELECT table_name, count(*) AS n FROM toydb_columns GROUP BY table_name'

# A view over a system table sees the catalog of the reading transaction.
> CREATE TABLE more (a INT PRIMARY KEY, b INT, c INT, d INT)
> SELECT * FROM wide WHERE n > 2 ORDER BY table_name
[plan]> SELECT n FROM wide WHERE table_name = 'more'
---
'emp', 3
'more', 4
Projection: wide.n
└─ Filter: wide.table_name = 'more'
   └─ View: wide
      └─ Projection: toydb_columns.table_name, #1 as n
         └─ Aggregate: toydb_columns.table_name, count(TRUE)
            └─ SystemTable: toydb_columns
4

# A table or view named like a system table hides it.
> CREATE VIEW toydb_keywords AS SELECT 'none' AS word
> SELECT * FROM toydb_keywords
> DROP VIEW toydb_keywords
> SELECT count(*) FROM toydb_keywords
---
'none'
106

