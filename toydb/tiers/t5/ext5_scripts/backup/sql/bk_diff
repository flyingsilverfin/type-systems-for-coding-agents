# Comparing backups with backup-diff (toybackup diff), and backups as of an
# earlier version.

> CREATE TABLE t (id INT PRIMARY KEY, v STRING)
> INSERT INTO t VALUES (1, 'a'), (2, 'b')
> CREATE USER alice
backup a
> UPDATE t SET v = 'B' WHERE id = 2
> DELETE FROM t WHERE id = 1
> INSERT INTO t VALUES (3, 'c')
> CREATE USER bob PASSWORD 'x'
> DROP USER alice
> CREATE TABLE u (id INT PRIMARY KEY)
> GRANT SELECT ON t TO bob
backup b
backup-diff a b
---
- user alice
+ user bob password
+ table u owner admin: CREATE TABLE u (id INTEGER PRIMARY KEY)
- row t: 1, 'a'
- row t: 2, 'b'
+ row t: 2, 'B'
+ row t: 3, 'c'
+ grant t to bob: SELECT

backup-diff b a
backup-diff a a
---
+ user alice
- user bob password
- table u owner admin: CREATE TABLE u (id INTEGER PRIMARY KEY)
+ row t: 1, 'a'
- row t: 2, 'B'
+ row t: 2, 'b'
- row t: 3, 'c'
- grant t to bob: SELECT

# A backup as of a version sees the database as a transaction AS OF SYSTEM
# TIME of that version does: the changes of earlier versions.
backup old as_of=3
backup-list old
backup-diff old a
!backup x as_of=99
> BEGIN
!backup x as_of=2
> COMMIT
---
toydb backup version 1
table t owner admin: CREATE TABLE t (id INTEGER PRIMARY KEY, v STRING DEFAULT NULL)
row t: 1, 'a'
row t: 2, 'b'
end 3 records, checksum 58af4355
+ user alice
Error: invalid input: version 99 does not exist
Error: invalid input: already in a transaction

# A changed table definition is a changed TABLE record; an invalid file is an
# error.
> DROP TABLE u
> CREATE TABLE u (id INT PRIMARY KEY, n INT)
backup c
backup-diff b c
backup-load bad 00
backup-diff b bad
---
- table u owner admin: CREATE TABLE u (id INTEGER PRIMARY KEY)
+ table u owner admin: CREATE TABLE u (id INTEGER PRIMARY KEY, n INTEGER DEFAULT NULL)
Error: invalid input: invalid backup: not a toydb backup
