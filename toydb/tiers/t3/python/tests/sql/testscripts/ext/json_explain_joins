# JSON output: plans of joins. Column numbers count across the joined rows,
# except for the hash join columns, which are columns of the left and right
# inputs.

> CREATE TABLE item (id INT PRIMARY KEY, name STRING INDEX, price FLOAT, qty INT)
> INSERT INTO item VALUES (1, 'apple', 1.5, 10), (2, 'pear', 2.25, 0), (3, 'fig', NULL, 7)
> CREATE TABLE sale (id INT PRIMARY KEY, item_id INT REFERENCES item, n INT)
> INSERT INTO sale VALUES (1, 1, 2), (2, 1, 5), (3, 3, 1)
---
ok

# An equi-join on the same table with aliases becomes a hash join.
[json]> EXPLAIN SELECT * FROM item a JOIN item b ON a.id = b.id
---
{"result":"explain","plan":{"statement":"select","root":{"node":"hash_join","join":"inner","left_column":{"column":0,"label":"a.id"},"right_column":{"column":0,"label":"b.id"},"left":{"node":"scan","table":"item","alias":"a","filter":null},"right":{"node":"scan","table":"item","alias":"b","filter":null}}}}

# A projection over a hash join, with a filter pushed into the left scan.
[plan]> SELECT s.id, i.name FROM sale s JOIN item i ON s.item_id = i.id WHERE s.n > 1
[json]> EXPLAIN SELECT s.id, i.name FROM sale s JOIN item i ON s.item_id = i.id WHERE s.n > 1
---
Projection: s.id, i.name
└─ HashJoin: inner on s.item_id = i.id
   ├─ Scan: sale as s (s.n > 1)
   └─ Scan: item as i
1, 'apple'
2, 'apple'
{"result":"explain","plan":{"statement":"select","root":{"node":"projection","expressions":[{"expr":{"column":0,"label":"s.id"},"alias":null},{"expr":{"column":4,"label":"i.name"},"alias":null}],"source":{"node":"hash_join","join":"inner","left_column":{"column":1,"label":"s.item_id"},"right_column":{"column":0,"label":"i.id"},"left":{"node":"scan","table":"sale","alias":"s","filter":{"op":"_ > _","args":[{"column":2,"label":"s.n"},{"constant":1}]}},"right":{"node":"scan","table":"item","alias":"i","filter":null}}}}}

# A cross join is a nested loop join without a predicate.
[json]> EXPLAIN SELECT * FROM item CROSS JOIN sale
---
{"result":"explain","plan":{"statement":"select","root":{"node":"nested_loop_join","join":"inner","predicate":null,"left":{"node":"scan","table":"item","alias":null,"filter":null},"right":{"node":"scan","table":"sale","alias":null,"filter":null}}}}

