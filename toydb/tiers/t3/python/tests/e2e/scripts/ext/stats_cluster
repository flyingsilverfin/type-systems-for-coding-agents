# Column statistics in a cluster: ANALYZE on one client is replicated through
# Raft and visible to every client, transactionally.

cluster nodes=3
---
ok

c1:> CREATE TABLE item (id INT PRIMARY KEY, name STRING INDEX, price FLOAT, qty INT)
c1:> INSERT INTO item VALUES (1, 'apple', 1.5, 10), (2, 'pear', 2.25, 0), (3, 'fig', NULL, 7), (4, 'apple', NAN, 10)
---
ok

c2:> SHOW STATISTICS item
---
c2: 'id', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL
c2: 'name', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL
c2: 'price', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL
c2: 'qty', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL

c1:[json]> ANALYZE item
c3:[header]> SHOW STATISTICS item
---
c1: {"result":"analyze","tables":["item"]}
c3: column, rows, nulls, distinct, min, max, top, top_count, avg_length
c3: 'id', 4, 0, 4, 1, 4, 1, 1, NULL
c3: 'name', 4, 0, 3, 'apple', 'pear', 'apple', 2, 4.25
c3: 'price', 4, 1, 3, 1.5, NaN, 1.5, 1, NULL
c3: 'qty', 4, 0, 3, 0, 10, 10, 2, NULL

c2:[json]> SHOW STATISTICS item
---
c2: {"result":"select","columns":["column","rows","nulls","distinct","min","max","top","top_count","avg_length"],"rows":[["id",4,0,4,1,4,1,1,null],["name",4,0,3,"apple","pear","apple",2,4.25],["price",4,1,3,1.5,{"type":"FLOAT","value":"NaN"},1.5,1,null],["qty",4,0,3,0,10,10,2,null]]}

# An uncommitted ANALYZE is invisible to other clients, and a concurrent one
# conflicts.
c2:> BEGIN
c2:> DELETE FROM item WHERE name = 'apple'
c2:> ANALYZE item
c2:> SHOW STATISTICS item
c3:> SHOW STATISTICS item
c1:!> ANALYZE item
---
c2: 'id', 2, 0, 2, 2, 3, 2, 1, NULL
c2: 'name', 2, 0, 2, 'fig', 'pear', 'fig', 1, 3.5
c2: 'price', 2, 1, 1, 2.25, 2.25, 2.25, 1, NULL
c2: 'qty', 2, 0, 2, 0, 7, 0, 1, NULL
c3: 'id', 4, 0, 4, 1, 4, 1, 1, NULL
c3: 'name', 4, 0, 3, 'apple', 'pear', 'apple', 2, 4.25
c3: 'price', 4, 1, 3, 1.5, NaN, 1.5, 1, NULL
c3: 'qty', 4, 0, 3, 0, 10, 10, 2, NULL
c1: Error: serialization failure, retry transaction

c2:> COMMIT
c1:> SHOW STATISTICS item
---
c1: 'id', 2, 0, 2, 2, 3, 2, 1, NULL
c1: 'name', 2, 0, 2, 'fig', 'pear', 'fig', 1, 3.5
c1: 'price', 2, 1, 1, 2.25, 2.25, 2.25, 1, NULL
c1: 'qty', 2, 0, 2, 0, 7, 0, 1, NULL

# A rolled-back ANALYZE leaves the committed statistics.
c3:> BEGIN
c3:> INSERT INTO item VALUES (9, 'kiwi', 0.5, 1)
c3:> ANALYZE
c3:> ROLLBACK
c1:> SHOW STATISTICS item
---
c1: 'id', 2, 0, 2, 2, 3, 2, 1, NULL
c1: 'name', 2, 0, 2, 'fig', 'pear', 'fig', 1, 3.5
c1: 'price', 2, 1, 1, 2.25, 2.25, 2.25, 1, NULL
c1: 'qty', 2, 0, 2, 0, 7, 0, 1, NULL

# DROP TABLE removes the statistics on every node.
c2:> DROP TABLE item
c3:> CREATE TABLE item (id INT PRIMARY KEY)
c1:> SHOW STATISTICS item
c2:!> SHOW STATISTICS nosuch
---
c1: 'id', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL
c2: Error: invalid input: table nosuch does not exist
