# a_child references b_parent and c references a_child, so b_parent comes first
# although a_child has the smaller name; a reference to the table itself
# doesn't count.
> EXPORT AS SQL
---
CREATE TABLE b_parent (
  id INTEGER PRIMARY KEY,
  name STRING DEFAULT NULL
);
INSERT INTO b_parent VALUES (1, 'one');
INSERT INTO b_parent VALUES (2, 'two');
CREATE TABLE a_child (
  id INTEGER PRIMARY KEY,
  p INTEGER DEFAULT NULL INDEX REFERENCES b_parent
);
INSERT INTO a_child VALUES (10, 1);
INSERT INTO a_child VALUES (11, 2);
CREATE TABLE c (
  id INTEGER PRIMARY KEY,
  a INTEGER DEFAULT NULL INDEX REFERENCES a_child
);
INSERT INTO c VALUES (100, 10);
CREATE TABLE self (
  id INTEGER PRIMARY KEY,
  up INTEGER DEFAULT NULL INDEX REFERENCES self
);
INSERT INTO self VALUES (1, NULL);
INSERT INTO self VALUES (2, 1);
CREATE TABLE zoo (
  k STRING PRIMARY KEY
);

