# Statement digests: the canonical form of SELECT statements (clauses, joins,
# aliases, functions, identifier quoting).

> CREATE TABLE t (id INT PRIMARY KEY, v STRING, n INT)
> INSERT INTO t VALUES (1, 'a', 10), (2, 'b', 20), (3, NULL, 30)
> CREATE TABLE u (id INT PRIMARY KEY, t_id INT REFERENCES t, w FLOAT)
> INSERT INTO u VALUES (1, 1, 0.5), (2, 1, 2.5), (3, 3, 4.0)
> CREATE TABLE "select" ("from" INT PRIMARY KEY, "a b" STRING)
> INSERT INTO "select" VALUES (1, 'x')
---
ok

# All clauses. ASC is left out, DESC kept; <> is !=; IS NOT NULL stays as
# written; an alias that needs quotes is quoted.
> select ID, v as "the name" from T x where x.id >= 2 and not (v <> 'a' or v is not null) order by 1 asc, v desc limit 5 offset 1
---
ok

# Joins: INNER and OUTER are left out, aliases always get AS.
> SELECT t.v, u.w FROM t INNER JOIN u ON u.t_id = t.id LEFT OUTER JOIN t t2 ON t2.id = u.id WHERE u.w > 1.0
> SELECT COUNT(*) FROM t CROSS JOIN u, t AS z
> SELECT * FROM u RIGHT OUTER JOIN t ON u.t_id = t.id
---
'a', 2.5
NULL, 4.0
27
1, 1, 0.5, 1, 'a', 10
2, 1, 2.5, 1, 'a', 10
NULL, NULL, NULL, 2, 'b', 20
3, 3, 4.0, 3, NULL, 30

# Aggregates and functions are written in lower case; GROUP BY and HAVING.
> SELECT n % 2, COUNT(*), Sum(n) FROM t GROUP BY n % 2 HAVING count(*) > 1
> SELECT SQRT(n), - n, +n, NOT TRUE FROM t WHERE id = 1
---
0, 3, 60
3.1622776601683795, -10, 10, FALSE

# SELECT without FROM, column aliases without AS, and quoted names.
> SELECT 1 + 2 * 3 AS x
> SELECT n m FROM t tt WHERE tt.id < 3
> SELECT "from", "a b" AS "c-d" FROM "select" WHERE "select"."from" = 1
---
7
10
20
1, 'x'

