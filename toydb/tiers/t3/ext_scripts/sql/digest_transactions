> UPDATE t SET n = 0 WHERE id = 1
> ROLLBACK
> begin read write
> COMMIT
> BEGIN READ ONLY
> SELECT * FROM t WHERE id = 2
!> UPDATE t SET n = 0 WHERE id = 2
> ROLLBACK
> BEGIN TRANSACTION READ ONLY AS OF SYSTEM TIME 2
> SELECT COUNT(*) FROM t
> COMMIT
!> COMMIT
!> BEGIN AS OF SYSTEM TIME 2
!> BEGIN READ ONLY AS OF SYSTEM TIME 99
