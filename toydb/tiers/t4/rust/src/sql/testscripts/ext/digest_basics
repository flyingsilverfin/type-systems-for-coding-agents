# Statement digests: SHOW STATEMENTS groups the statements a session has
# executed by their digest, in order of first execution.

> CREATE TABLE t (id INT PRIMARY KEY, v STRING, n INT)
> INSERT INTO t VALUES (1, 'a', 10), (2, 'b', 20), (3, NULL, 30)
---
ok

# Letter case, whitespace, redundant parentheses and literal values don't
# matter. A failed statement counts as a call and an error, and adds no rows.
# A statement that doesn't parse is not recorded.
> select * from T where ID = 1
> SELECT * FROM t WHERE (id = 2)
> SELECT  *  FROM  t  WHERE  id  =  99
!> SELECT * FROM t WHERE v = 1
!> SELECT * FROM nosuch
!> SELECT FROM t
---
1, 'a', 10
2, 'b', 20
Error: invalid input: can't compare 'a' and 1
Error: invalid input: table nosuch does not exist
Error: invalid input: expected expression atom, found FROM

[header]> SHOW STATEMENTS
---
digest, calls, errors, rows
'CREATE TABLE t (id INTEGER PRIMARY KEY, v STRING, n INTEGER)', 1, 0, 0
'INSERT INTO t VALUES (?, ?, ?), (?, ?, ?), (?, ?, ?)', 1, 0, 3
'SELECT * FROM t WHERE id = ?', 3, 0, 2
'SELECT * FROM t WHERE v = ?', 1, 1, 0
'SELECT * FROM nosuch', 1, 1, 0

# SHOW STATEMENTS is not recorded itself. Every kind of literal is a ?, and a
# negative number is - applied to a literal.
> SELECT 'x', 1.5, TRUE, NULL, -3, NAN, INFINITY
> SELECT 'it''s', 2e10, FALSE, NULL, -7, NAN, -INFINITY
> INSERT INTO t VALUES (4, 'd', 40)
> SELECT * FROM t WHERE id = 4
---
'x', 1.5, TRUE, NULL, -3, NaN, inf
'it\'s', 20000000000.0, FALSE, NULL, -7, NaN, -inf
4, 'd', 40

> SHOW STATEMENTS
