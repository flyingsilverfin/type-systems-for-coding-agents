# Exponentiation, prefix and postfix operators. A unary + is not displayed and
# is written as its operand.
[plan]> SELECT a ^ b ^ 2, (a ^ b) ^ 2, -a, +a, a!, -(a!) FROM e WHERE id = 1
[json]> EXPLAIN SELECT a ^ b ^ 2, (a ^ b) ^ 2, -a, +a, a!, -(a!) FROM e WHERE id = 1
---
Projection: e.a ^ e.b ^ 2, e.a ^ e.b ^ 2, -e.a, e.a, e.a!, -(e.a!)
└─ KeyLookup: e (1)
512, 64, -2, 2, 2, -2
