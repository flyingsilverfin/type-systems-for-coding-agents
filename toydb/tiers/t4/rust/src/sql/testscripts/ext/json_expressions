# JSON output: every existing kind of plan expression. The structure is that
# of the plan's expression tree; "op" is the expression's own plan display with
# each operand replaced by _ (parentheses around an operand go with it).

> CREATE TABLE e (id INT PRIMARY KEY, a INT, b INT, f FLOAT, s STRING, t BOOLEAN)
> INSERT INTO e VALUES (1, 2, 3, 4.0, 'xy', TRUE), (2, -1, 0, 0.25, 'ab', FALSE)
---
ok

# Arithmetic and grouping. The plan display shows a - (b - 1) and a - b - 1
# alike, but they are different trees.
[plan]> SELECT a + b * 2, (a + b) * 2, a - (b - 1), a - b - 1 FROM e
[json]> EXPLAIN SELECT a + b * 2, (a + b) * 2, a - (b - 1), a - b - 1 FROM e
---
Projection: e.a + e.b * 2, (e.a + e.b) * 2, e.a - e.b - 1, e.a - e.b - 1
└─ Scan: e
8, 10, 0, -2
-1, -2, 0, -2
