# Comparisons that the plan shows as combinations are written as those
# combinations; IS NOT NULL is NOT of IS NULL.
[plan]> SELECT a >= b, a <= b, a != b, a <> b, a IS NULL, f IS NAN, a IS NOT NULL FROM e
[json]> EXPLAIN SELECT a >= b, a <= b, a != b, a <> b, a IS NULL, f IS NAN, a IS NOT NULL FROM e
---
Projection: e.a > e.b OR e.a = e.b, e.a < e.b OR e.a = e.b, NOT e.a = e.b, NOT e.a = e.b, e.a IS NULL, e.f IS NAN, NOT e.a IS NULL
└─ Scan: e
FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, TRUE
FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, TRUE
