# EXECUTE checks its arguments: their number, then each argument in order (a
# constant expression, whose value must be NULL or of the parameter's type).

> CREATE TABLE t (id INT PRIMARY KEY, v STRING, f FLOAT, b BOOLEAN)
> INSERT INTO t VALUES (1, 'a', 1.5, TRUE), (2, 'it''s', NAN, FALSE), (3, NULL, -0.5, NULL)
> PREPARE get (INT) AS SELECT v FROM t WHERE id = $1
> PREPARE two (INT, INT) AS SELECT $1 + $2
---
ok

!> EXECUTE nosuch
!> EXECUTE nosuch (1)
!> EXECUTE get
!> EXECUTE get (1, 2)
!> EXECUTE two (1)
---
Error: invalid input: prepared statement nosuch does not exist
Error: invalid input: prepared statement nosuch does not exist
Error: invalid input: wrong number of arguments for prepared statement get: expected 1, found 0
Error: invalid input: wrong number of arguments for prepared statement get: expected 1, found 2
Error: invalid input: wrong number of arguments for prepared statement two: expected 2, found 1

# No conversions between types, not even from INTEGER to FLOAT.
!> EXECUTE get ('1')
!> EXECUTE get (1.0)
!> EXECUTE get (TRUE)
> PREPARE fl (FLOAT) AS SELECT $1 * 2
!> EXECUTE fl (1)
> EXECUTE fl (1.5)
---
Error: invalid input: invalid datatype STRING for INTEGER parameter $1
Error: invalid input: invalid datatype FLOAT for INTEGER parameter $1
Error: invalid input: invalid datatype BOOLEAN for INTEGER parameter $1
Error: invalid input: invalid datatype INTEGER for FLOAT parameter $1
3.0

# NULL is accepted for every type.
> EXECUTE get (NULL)
> EXECUTE two (NULL, 1)
> EXECUTE fl (NULL)
---
NULL
NULL

# Arguments are constant expressions, evaluated in order; the first problem is
# reported.
> EXECUTE get (1 + 1)
> EXECUTE two (-9223372036854775807 - 1, 1)
!> EXECUTE get (x)
!> EXECUTE get (1 / 0)
!> EXECUTE two ('x', 1 / 0)
!> EXECUTE two (1 / 0, 'x')
!> EXECUTE two (1, 'x')
!> EXECUTE two (9223372036854775807, 1)
---
'it\'s'
-9223372036854775807
Error: invalid input: expression must be constant, found column x
Error: invalid input: can't divide by zero
Error: invalid input: invalid datatype STRING for INTEGER parameter $1
Error: invalid input: can't divide by zero
Error: invalid input: invalid datatype STRING for INTEGER parameter $2
Error: invalid input: integer overflow

# The statement behaves as if the values were written in place of the
# parameters: negative numbers, NaN, infinities, strings with quotes.
> PREPARE vals (INT, FLOAT, STRING, BOOLEAN) AS SELECT $1, -$1, $2, $2 IS NAN, $3, $3 LIKE 'it%', $4, NOT $4
> EXECUTE vals (-5, NAN, 'it''s', FALSE)
> EXECUTE vals (NULL, -INFINITY, '', TRUE)
---
-5, 5, NaN, TRUE, 'it\'s', TRUE, FALSE, TRUE
NULL, NULL, -inf, FALSE, '', FALSE, TRUE, FALSE

> PREPARE byf (FLOAT) AS SELECT id FROM t WHERE f = $1 OR f IS NAN
