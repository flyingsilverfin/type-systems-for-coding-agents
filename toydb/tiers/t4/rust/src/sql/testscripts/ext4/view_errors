# VIEW and VIEWS are reserved keywords; quoted, they are ordinary names.
!> CREATE TABLE view (id INT PRIMARY KEY)
!> SELECT 1 AS views
---
Error: invalid input: expected identifier, got VIEW
Error: invalid input: expected identifier, got VIEWS

> CREATE VIEW "view" AS SELECT id AS "views" FROM t WHERE id = 1
> SELECT "view"."views" FROM "view"
> SHOW VIEWS
---
1
'bad', 'a', 'SELECT 1 / 0 AS a'
'view', '\"views\"', 'SELECT id AS \"views\" FROM t WHERE id = 1'
'w', 'id', 'SELECT id FROM t'
'x', 'a, b', 'SELECT id, id + 1 FROM t'
'y', 'id, \"ID\"', 'SELECT id, id AS \"ID\" FROM t'

