# The selectivity of a condition is estimated from its parts, as the plan
# shows them: >= is planned as > OR =, != as NOT =.

> CREATE TABLE item (id INT PRIMARY KEY, name STRING INDEX, price FLOAT, qty INT, cat STRING)
> INSERT INTO item VALUES (1, 'a', 1.0, 10, 'x'), (2, 'b', 2.0, 20, 'x'), (3, 'c', 3.0, NULL, 'y'), (4, 'd', 4.0, 20, 'y'), (5, 'e', 5.0, 30, 'y'), (6, 'f', 6.0, 40, 'z'), (7, 'g', 7.0, NULL, NULL), (8, 'h', 8.0, 10, 'z'), (9, 'i', 9.0, 20, 'x'), (10, 'j', 10.0, 50, NULL)
> ANALYZE item
---
ok

# OR, NOT, AND.
> ESTIMATE SELECT * FROM item WHERE price >= 5
> ESTIMATE SELECT * FROM item WHERE price != 5
> ESTIMATE SELECT * FROM item WHERE price > 2 AND qty < 30
> ESTIMATE SELECT * FROM item WHERE NOT (qty > 25 OR cat = 'z')
---
'Scan: item (item.price > 5 OR item.price = 5)', 6
'Scan: item (NOT item.price = 5)', 9
'Scan: item (item.price > 2 AND item.qty < 30)', 4
'Scan: item (NOT (item.qty > 25 OR item.cat = \'z\'))', 4

# A constant may be on either side.
> ESTIMATE SELECT * FROM item WHERE 5 > price
---
'Scan: item (5 > item.price)', 4

# Ranges are limited to the minimum and maximum.
> ESTIMATE SELECT * FROM item WHERE price < 0
> ESTIMATE SELECT * FROM item WHERE price > 100
> ESTIMATE SELECT * FROM item WHERE price < 100
> ESTIMATE SELECT * FROM item WHERE qty > 50
---
'Scan: item (item.price < 0)', 0
'Scan: item (item.price > 100)', 0
'Scan: item (item.price < 100)', 10
'Scan: item (item.qty > 50)', 0

# Two columns: 1 / the larger number of distinct values. A comparison with the
# NULL constant is never true (0), so != NULL, planned as NOT = NULL, is 1. Any
# other condition is 0.25.
> ESTIMATE SELECT * FROM item WHERE qty = price
> ESTIMATE SELECT * FROM item WHERE qty = NULL
> ESTIMATE SELECT * FROM item WHERE qty != NULL
> ESTIMATE SELECT * FROM item WHERE qty * 2 > 10 AND cat = 'x'
> ESTIMATE SELECT * FROM item WHERE name < 'c'
---
'Scan: item (item.qty = item.price)', 1
'Scan: item (item.qty = NULL)', 0
'Scan: item (NOT item.qty = NULL)', 10
'Scan: item (item.qty * 2 > 10 AND item.cat = \'x\')', 1
'Scan: item (item.name < \'c\')', 3

# Conditions that are always true or false are removed by the optimizer.
> ESTIMATE SELECT * FROM item WHERE TRUE
> ESTIMATE SELECT * FROM item WHERE 1 = 2
---
'Scan: item', 10
'Nothing', 0

# A Filter above a lookup uses the statistics of the table's columns.
> ESTIMATE SELECT * FROM item WHERE id = 3 AND qty > 0
---
'Filter: item.qty > 0', 1
'└─ KeyLookup: item (3)', 1

# Columns traced through a projection keep their statistics; computed columns
# have none.
> CREATE VIEW v AS SELECT id, qty, qty + 0 AS q FROM item
> ESTIMATE SELECT * FROM v WHERE qty = 20
> ESTIMATE SELECT * FROM v WHERE q = 20
---
'Filter: v.qty = 20', 2
'└─ View: v', 10
'   └─ Projection: item.id, item.qty, item.qty + 0 as q', 10
'      └─ Scan: item', 10
'Filter: v.q = 20', 1
'└─ View: v', 10
'   └─ Projection: item.id, item.qty, item.qty + 0 as q', 10
'      └─ Scan: item', 10

# A range is interpolated only if max - min is a finite number: from -1e308 to
# 1e308 it isn't, so 1/3 is used.
> CREATE TABLE wide (id INT PRIMARY KEY, f FLOAT)
> INSERT INTO wide VALUES (1, -1e308), (2, 0.0), (3, 1e308)
> ANALYZE wide
> ESTIMATE SELECT * FROM wide WHERE f < 0
> ESTIMATE SELECT * FROM wide WHERE f > -1e308
---
'Scan: wide (wide.f < 0)', 1
'Scan: wide (wide.f > -1e308)', 1
