# Changes of the catalog: tables, statistics and views.

> CREATE TABLE dept (id INT PRIMARY KEY, name STRING NOT NULL UNIQUE)
> CREATE TABLE emp (id INT PRIMARY KEY, name STRING DEFAULT 'none', dept_id INT REFERENCES dept, pay FLOAT INDEX)
> INSERT INTO dept VALUES (1, 'eng')
> INSERT INTO emp VALUES (1, 'ann', 1, 1.5)
> SHOW CHANGES
---
1, 'dept', 'create_table', NULL, 'CREATE TABLE dept (id INTEGER PRIMARY KEY, name STRING NOT NULL UNIQUE INDEX)'
2, 'emp', 'create_table', NULL, 'CREATE TABLE emp (id INTEGER PRIMARY KEY, name STRING DEFAULT \'none\', dept_id INTEGER DEFAULT NULL INDEX REFERENCES dept, pay FLOAT DEFAULT NULL INDEX)'
3, 'dept', 'insert', 1, '{\"id\":1,\"name\":\"eng\"}'
4, 'emp', 'insert', 1, '{\"id\":1,\"name\":\"ann\",\"dept_id\":1,\"pay\":1.5}'

# ANALYZE records one change per table, in name order.
> ANALYZE
> ANALYZE emp
> SHOW CHANGES SINCE 4
---
5, 'dept', 'analyze', NULL, NULL
5, 'emp', 'analyze', NULL, NULL
6, 'emp', 'analyze', NULL, NULL

# Views.
> CREATE VIEW staff AS SELECT e.name, d.name AS dept FROM emp e JOIN dept d ON e.dept_id = d.id
> CREATE VIEW "Names" (n) AS SELECT name FROM staff WHERE name != 'x'
> DROP VIEW "Names"
> SHOW CHANGES SINCE 6
---
7, 'staff', 'create_view', NULL, 'CREATE VIEW staff (name, dept) AS SELECT e.name, d.name AS dept FROM emp AS e JOIN dept AS d ON e.dept_id = d.id'
8, 'Names', 'create_view', NULL, 'CREATE VIEW \"Names\" (n) AS SELECT name FROM staff WHERE name != \'x\''
9, 'Names', 'drop_view', NULL, NULL

# DROP TABLE is a single change: its rows, index entries and statistics are not
# recorded separately.
> DROP VIEW staff
> DROP TABLE emp
> SHOW CHANGES SINCE 9
---
10, 'staff', 'drop_view', NULL, NULL
11, 'emp', 'drop_table', NULL, NULL

# Failed statements and statements that change nothing record nothing.
!> CREATE TABLE dept (id INT PRIMARY KEY)
!> DROP TABLE dept_x
> DROP TABLE IF EXISTS dept_x
> DROP VIEW IF EXISTS v
!> INSERT INTO dept VALUES (2, 'eng')
> SHOW CHANGES SINCE 11
---
Error: invalid input: table dept already exists
Error: invalid input: table dept_x does not exist
Error: invalid input: value 'eng' already in unique column name

# Reading statements record nothing.
> SELECT * FROM dept
> EXPORT AS SQL
> SHOW STATISTICS dept
> SHOW CHANGES SINCE 11
