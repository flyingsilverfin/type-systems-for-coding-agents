# PREPARE names a statement with typed parameters $1, $2, ...; EXECUTE runs it
# with the given arguments in place of the parameters.

> CREATE TABLE t (id INT PRIMARY KEY, v STRING, n INT)
> INSERT INTO t VALUES (1, 'a', 10), (2, 'b', 20), (3, 'c', NULL)
---
ok

> PREPARE get (INT) AS SELECT v FROM t WHERE id = $1
> EXECUTE get (1)
> EXECUTE get (3)
> EXECUTE get (9)
---
'a'
'c'

# Parameters can be used wherever a literal can, and more than once; types
# without a parameter are allowed.
> PREPARE q (INT, INT) AS SELECT id, n + $2 FROM t WHERE n > $1 ORDER BY id DESC LIMIT $2
> EXECUTE q (5, 1)
> EXECUTE q (5, 2)
> PREPARE r (STRING, INT) AS SELECT $1, $1 = 'x'
> EXECUTE r ('x', 7)
---
2, 21
2, 22
1, 12
'x', TRUE

# A statement without parameters.
> PREPARE all_rows AS SELECT * FROM t
[header]> EXECUTE all_rows
---
t.id, t.v, t.n
1, 'a', 10
2, 'b', 20
3, 'c', NULL

# Writes. The result of EXECUTE is the result of the statement.
[json]> PREPARE ins (INT, STRING) AS INSERT INTO t (id, v) VALUES ($1, $2)
[json]> EXECUTE ins (4, 'd')
[json]> EXECUTE ins (5, NULL)
> PREPARE bump (INT) AS UPDATE t SET n = n + $1 WHERE n IS NOT NULL
[json]> EXECUTE bump (5)
> PREPARE del (INT) AS DELETE FROM t WHERE id >= $1
[json]> EXECUTE del (5)
> SELECT * FROM t
