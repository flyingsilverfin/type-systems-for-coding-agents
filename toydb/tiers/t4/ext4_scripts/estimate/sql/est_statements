# Errors are those of EXPLAIN, including errors of constant folding.
!> ESTIMATE SELECT * FROM nosuch
!> ESTIMATE SELECT nosuch FROM item
!> ESTIMATE SELECT 1 / 0
!> ESTIMATE INSERT INTO item VALUES (1 / 0)
---
Error: invalid input: table nosuch does not exist
Error: invalid input: unknown column nosuch
Error: invalid input: can't divide by zero
Error: invalid input: can't divide by zero

# Only planned statements can be estimated.
!> ESTIMATE BEGIN
!> ESTIMATE EXPLAIN SELECT 1
!> ESTIMATE ANALYZE item
!> ESTIMATE SHOW STATISTICS item
!> ESTIMATE FORMAT SELECT 1
!> ESTIMATE ESTIMATE SELECT 1
!> ESTIMATE DESCRIBE item
!> ESTIMATE CREATE VIEW v AS SELECT 1 AS a
!> ESTIMATE SHOW PREPARED
!> EXPLAIN ESTIMATE SELECT 1
