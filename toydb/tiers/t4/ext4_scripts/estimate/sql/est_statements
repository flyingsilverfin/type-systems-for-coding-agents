# ESTIMATE of writes and schema statements: the statement line estimates the
# rows written. Nothing is executed.

> CREATE TABLE item (id INT PRIMARY KEY, qty INT, cat STRING)
> INSERT INTO item VALUES (1, 10, 'x'), (2, NULL, 'y'), (3, 30, 'y'), (4, 40, 'y')
> ANALYZE item
---
ok

> ESTIMATE INSERT INTO item VALUES (5, 1, 'z'), (6, 2, 'z'), (7, 3, 'z')
> ESTIMATE UPDATE item SET qty = 0 WHERE cat = 'y'
> ESTIMATE DELETE FROM item WHERE qty IS NULL
> ESTIMATE DELETE FROM item WHERE id = 1
> ESTIMATE CREATE TABLE z (id INT PRIMARY KEY)
> ESTIMATE DROP TABLE item
---
'Insert: item', 3
'└─ Values: 3 rows', 3
'Update: item (qty=0)', 2
'└─ Scan: item (item.cat = \'y\')', 2
'Delete: item', 1
'└─ Scan: item (item.qty IS NULL)', 1
'Delete: item', 1
'└─ KeyLookup: item (1)', 1
'CreateTable: z', 0
'DropTable: item', 0

> SELECT * FROM item
schema
