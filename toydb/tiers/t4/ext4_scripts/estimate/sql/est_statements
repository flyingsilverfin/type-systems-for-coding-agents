# The statistics are those the transaction sees.
a:> BEGIN
a:> INSERT INTO item VALUES (5, 50, 'z'), (6, 60, 'z')
a:> ANALYZE item
a:> ESTIMATE SELECT * FROM item
b:> ESTIMATE SELECT * FROM item
a:> ROLLBACK
a:> ESTIMATE SELECT * FROM item
---
a: 'Scan: item', 6
b: 'Scan: item', 4
a: 'Scan: item', 4

