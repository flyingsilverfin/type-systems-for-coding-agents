# A view depends on the tables and views its query reads. They can't be
# dropped while it exists.

> CREATE TABLE a (id INT PRIMARY KEY, v INT)
> CREATE TABLE b (id INT PRIMARY KEY, a_id INT REFERENCES a)
> CREATE TABLE c (id INT PRIMARY KEY)
> INSERT INTO a VALUES (1, 10), (2, 20)
> INSERT INTO b VALUES (1, 1), (2, 1), (3, 2)
> CREATE VIEW va AS SELECT * FROM a
> CREATE VIEW vab AS SELECT a.id, b.id AS b_id FROM a JOIN b ON b.a_id = a.id
> CREATE VIEW vva AS SELECT id FROM va WHERE v > 10
> CREATE VIEW vz AS SELECT id FROM c
> CREATE VIEW vc AS SELECT id FROM c
---
ok

# The existing checks of DROP TABLE come first (a is referenced by b).
!> DROP TABLE a
!> DROP TABLE b
!> DROP TABLE IF EXISTS b
!> DROP TABLE c
---
Error: invalid input: table a is referenced from b.a_id
Error: invalid input: table b is used by view vab
Error: invalid input: table b is used by view vab
Error: invalid input: table c is used by view vc

# Views using views.
!> DROP VIEW va
> SELECT * FROM vva
---
Error: invalid input: view va is used by view vva
2

# Dependencies are direct: a is used by va and vab, not by vva.
> DROP VIEW vva
> DROP VIEW va
!> DROP TABLE b
> DROP VIEW vab
> DROP TABLE b
> DROP TABLE a
---
Error: invalid input: table b is used by view vab

# Nothing was changed by the failed statements; c is still used by two views.
> SELECT * FROM vz
!> DROP TABLE c
> DROP VIEW vc
!> DROP TABLE c
> DROP VIEW vz
> DROP TABLE c
> SHOW VIEWS
---
Error: invalid input: table c is used by view vc
Error: invalid input: table c is used by view vz

# A dropped table can be created again, and a view on it with it.
> CREATE TABLE a (id INT PRIMARY KEY, name STRING)
> INSERT INTO a VALUES (7, 'x')
> CREATE VIEW va AS SELECT name FROM a
> SELECT * FROM va
!> DROP TABLE a
---
'x'
Error: invalid input: table a is used by view va

# A view without FROM depends on nothing.
> CREATE VIEW k AS SELECT 1 AS one
> DROP VIEW va
> DROP TABLE a
> SELECT * FROM k
---
1

