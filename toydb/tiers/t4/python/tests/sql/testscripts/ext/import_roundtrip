# Exported CSV and JSON lines import back into the same values.

> CREATE TABLE src (id INT PRIMARY KEY, b BOOLEAN, f FLOAT, s STRING)
> INSERT INTO src VALUES (1, TRUE, 1.5, 'a,b'), (2, NULL, NAN, ''), (3, FALSE, -INFINITY, 'say "x"'), (4, TRUE, 1e100, NULL), (5, NULL, NULL, 'plain')
> CREATE TABLE dst (id INT PRIMARY KEY, b BOOLEAN, f FLOAT, s STRING)
> CREATE TABLE dst2 (id INT PRIMARY KEY, b BOOLEAN, f FLOAT, s STRING)
---
ok

> EXPORT src AS CSV
---
id,b,f,s
1,TRUE,1.5,"a,b"
2,,NaN,""
3,FALSE,-inf,"say ""x"""
4,TRUE,1e100,
5,,,plain

[json]> IMPORT INTO dst FROM CSV 'id,b,f,s', '1,TRUE,1.5,"a,b"', '2,,NaN,""', '3,FALSE,-inf,"say ""x"""', '4,TRUE,1e100,', '5,,,plain'
---
{"result":"insert","count":5}

> EXPORT src AS JSON
---
{"id":1,"b":true,"f":1.5,"s":"a,b"}
{"id":2,"b":null,"f":{"type":"FLOAT","value":"NaN"},"s":""}
{"id":3,"b":false,"f":{"type":"FLOAT","value":"-inf"},"s":"say \"x\""}
{"id":4,"b":true,"f":1e100,"s":null}
{"id":5,"b":null,"f":null,"s":"plain"}

[json]> IMPORT INTO dst2 FROM JSON '{"id":1,"b":true,"f":1.5,"s":"a,b"}', '{"id":2,"b":null,"f":{"type":"FLOAT","value":"NaN"},"s":""}', '{"id":3,"b":false,"f":{"type":"FLOAT","value":"-inf"},"s":"say \"x\""}', '{"id":4,"b":true,"f":1e100,"s":null}', '{"id":5,"b":null,"f":null,"s":"plain"}'
---
{"result":"insert","count":5}

