# DESCRIBE plans a statement as EXPLAIN does, but neither optimizes nor
# executes it. Statements that return no rows have no result columns.

> CREATE TABLE t (id INT PRIMARY KEY, v STRING)
> INSERT INTO t VALUES (1, 'a')
---
ok

# Writes and schema changes are described without effect.
> DESCRIBE INSERT INTO t VALUES (2, 'b')
> DESCRIBE UPDATE t SET v = 'x'
> DESCRIBE DELETE FROM t
> DESCRIBE CREATE TABLE u (id INT PRIMARY KEY)
> DESCRIBE DROP TABLE t
> DESCRIBE DROP TABLE nosuch
> SELECT * FROM t
