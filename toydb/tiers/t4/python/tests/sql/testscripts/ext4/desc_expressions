# The type of an expression is the data type of the values it returns when it
# succeeds, unknown (NULL) if that depends on the values or if it can't return a
# non-NULL value. An expression is nullable if it can return NULL.

> CREATE TABLE t (id INT PRIMARY KEY, i INT, f FLOAT, s STRING NOT NULL, b BOOLEAN)
---
ok

# Constants and columns. Computed columns have no name.
[header]> DESCRIBE SELECT 1, 1.5, 'a', TRUE, NULL, -1, -1.5, id, i, t.s, b AS flag FROM t
---
column, type, nullable
NULL, 'INTEGER', FALSE
NULL, 'FLOAT', FALSE
NULL, 'STRING', FALSE
NULL, 'BOOLEAN', FALSE
NULL, NULL, TRUE
NULL, 'INTEGER', FALSE
NULL, 'FLOAT', FALSE
't.id', 'INTEGER', FALSE
't.i', 'INTEGER', TRUE
't.s', 'STRING', FALSE
'flag', 'BOOLEAN', TRUE

# Arithmetic: INTEGER with INTEGER is INTEGER, with a FLOAT it is FLOAT; ^ of
# two integers is unknown (a negative exponent gives a float); other operand
# types fail, so the type is unknown.
