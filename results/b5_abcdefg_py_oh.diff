 """Read-side queries, one function per command, grouped by the entity each command is about."""
+from __future__ import annotations
+
+from datetime import date
+from typing import Optional
+
+from typedb.driver import ConceptRow
+
+from lending.errors import DataError
+
+
+def req_str(row: ConceptRow, var: str) -> str:
+    if (concept := row.get(var)) is None or (value := concept.try_get_string()) is None:
+        raise DataError(f"${var}: expected a string")
+    return value
+
+
+def opt_str(row: ConceptRow, var: str) -> Optional[str]:
+    if (concept := row.get(var)) is None:
+        return None
+    if (value := concept.try_get_string()) is None:
+        raise DataError(f"${var}: expected a string")
+    return value
+
+
+def req_int(row: ConceptRow, var: str) -> int:
+    if (concept := row.get(var)) is None or (value := concept.try_get_integer()) is None:
+        raise DataError(f"${var}: expected an integer")
+    return value
+
+
+def opt_int(row: ConceptRow, var: str) -> Optional[int]:
+    if (concept := row.get(var)) is None:
+        return None
+    if (value := concept.try_get_integer()) is None:
+        raise DataError(f"${var}: expected an integer")
+    return value
+
+
+def req_date(row: ConceptRow, var: str) -> date:
+    if (concept := row.get(var)) is None or (value := concept.try_get_date()) is None:
+        raise DataError(f"${var}: expected a date")
+    return value
+
+
+def opt_date(row: ConceptRow, var: str) -> Optional[date]:
+    if (concept := row.get(var)) is None:
+        return None
+    if (value := concept.try_get_date()) is None:
+        raise DataError(f"${var}: expected a date")
+    return value
