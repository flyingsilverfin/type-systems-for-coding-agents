diff --git a/app/src/repo/mod.rs b/app/src/repo/mod.rs
index 6e6e2b9..0f878f3 100644
--- a/app/src/repo/mod.rs
+++ b/app/src/repo/mod.rs
@@ -2,7 +2,31 @@
 //!
 //! Commands whose output depends on loan status return `model::Loan`, so the status rules live in one
 //! place; the others return small purpose-built rows holding only the columns the command needs.
-//! Column values are extracted inline with `ConceptRow::get` and the `Concept::try_get_*` accessors.
+//! Column values are extracted inline with `ConceptRow::get` and the `Concept::try_get_*` accessors; a loan's
+//! `returned` and `lost` columns are combined into a `LoanStatus` by `loan_status`.
 pub mod books;
 pub mod loans;
 pub mod members;
+
+use chrono::NaiveDate;
+use typedb_driver::{answer::ConceptRow, concept::Concept};
+
+use crate::{
+    error::{AppError, Result},
+    model::LoanStatus,
+};
+
+/// The date in `column`, or `None` if the row has no value there.
+fn optional_date(row: &ConceptRow, column: &str) -> Result<Option<NaiveDate>> {
+    row.get(column)?.map(|concept| concept.try_get_date().ok_or_else(|| AppError::column(column, "date"))).transpose()
+}
+
+/// The date in `column`, which the query guarantees is bound.
+fn required_date(row: &ConceptRow, column: &str) -> Result<NaiveDate> {
+    row.get(column)?.and_then(Concept::try_get_date).ok_or_else(|| AppError::column(column, "date"))
+}
+
+/// The status of the loan in this row, from its optional `returned` and `lost` columns.
+fn loan_status(row: &ConceptRow) -> Result<LoanStatus> {
+    Ok(LoanStatus::from_dates(optional_date(row, "returned")?, optional_date(row, "lost")?))
+}
