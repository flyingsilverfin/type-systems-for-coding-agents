+/// Where a loan stands: exactly one of open, returned (on a date) or lost (on a date).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum LoanStatus {
+    Open,
+    Returned(NaiveDate),
+    Lost(NaiveDate),
+}
+
+impl LoanStatus {
+    /// Build the status from the stored dates. A lost loan counts as lost even if it also carries a return date.
+    pub fn from_dates(returned: Option<NaiveDate>, lost: Option<NaiveDate>) -> Self {
+        match (returned, lost) {
+            (_, Some(lost)) => LoanStatus::Lost(lost),
+            (Some(returned), None) => LoanStatus::Returned(returned),
+            (None, None) => LoanStatus::Open,
+        }
+    }
+}
+
