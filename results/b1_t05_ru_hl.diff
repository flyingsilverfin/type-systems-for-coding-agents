+pub fn find_book(db: &Db, isbn: &str) -> Result<Option<Book>> {
+    let rows = db.read_rows(&format!(
+        "
+        match
+          $b isa book, has isbn {}, has title $t, has year $y, has copies $c;
+          try {{ $b has genre $g; }};
+        ",
+        quote(isbn)
+    ))?;
+    let Some(row) = rows.first() else { return Ok(None) };
+    Ok(Some(Book {
+        isbn: isbn.to_owned(),
+        title: req_string(row, "t")?,
+        year: req_integer(row, "y")?,
+        genre: string(row, "g")?,
+        copies: req_integer(row, "c")?,
+    }))
+}
