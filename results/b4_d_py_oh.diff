+def _emails_by_member(db: Db, member_filter: str) -> dict[str, tuple[str, ...]]:
+    """All email addresses per member id (sorted, distinct) for members matching `member_filter`."""
+    rows = db.read_rows(f"""
+        match
+          $m isa member, has member-id $mid{member_filter};
+          $m has email $e;
+    """)
+    emails: dict[str, set[str]] = {}
+    for row in rows:
+        emails.setdefault(_required_string(row, "mid"), set()).add(_required_string(row, "e"))
+    return {mid: tuple(sorted(values)) for mid, values in emails.items()}
+
