+
+/// A member who has borrowed a book, with how many loans of that book they have.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Borrower {
+    pub member_id: String,
+    pub name: String,
+    pub loans: usize,
+}
+
+/// Every member who has ever borrowed the book (any loan status), or `None` if there is no such book.
+pub fn borrowers(db: &Db, isbn: &str) -> Result<Option<Vec<Borrower>>> {
+    let book_rows = db.read_rows(&format!("match $b isa book, has isbn {};", quote(isbn)))?;
+    if book_rows.is_empty() {
+        return Ok(None);
+    }
+    let rows = db.read_rows(&format!(
+        "
+        match
+          $b isa book, has isbn {};
+          $l isa loan, links (borrower: $m, item: $b), has loan-id $loan_id;
+          $m has member-id $member_id, has name $name;
+        ",
+        quote(isbn)
+    ))?;
+    let mut counts: std::collections::BTreeMap<String, Borrower> = std::collections::BTreeMap::new();
+    for row in &rows {
+        let member_id = row.get("member_id")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("member_id", "string"))?
+            .to_owned();
+        let name = row.get("name")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("name", "string"))?
+            .to_owned();
+        counts
+            .entry(member_id.clone())
+            .or_insert(Borrower { member_id, name, loans: 0 })
+            .loans += 1;
+    }
+    Ok(Some(counts.into_values().collect()))
+}
