+
+/// The members who have borrowed a book, most loans first, then member id.
+pub fn borrowers(isbn: &str, borrowers: &[Borrower]) -> Vec<String> {
+    let mut ordered: Vec<&Borrower> = borrowers.iter().collect();
+    ordered.sort_by(|a, b| b.loans.cmp(&a.loans).then(a.member_id.cmp(&b.member_id)));
+    let mut lines = vec![format!("borrowers {isbn}: {} members", ordered.len())];
+    lines.extend(ordered.iter().map(|b| format!("  {} {} ({} loans)", b.member_id, b.name, b.loans)));
+    lines
+}
