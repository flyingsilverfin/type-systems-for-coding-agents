 use chrono::NaiveDate;
 
+/// The stored integer key of a member id written as `M` followed by digits (`M042` is 42), or `None`
+/// if the text is not such an id.
+pub fn member_key(text: &str) -> Option<i64> {
+    let digits = text.strip_prefix('M')?;
+    if digits.is_empty() || !digits.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    digits.parse().ok()
+}
+
+/// The text form of a stored member key: `M` followed by at least three digits.
+pub fn member_label(key: i64) -> String {
+    format!("M{key:03}")
+}
+
