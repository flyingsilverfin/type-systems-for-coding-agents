+/// Email addresses per member id (all members, or just the given one), sorted and without duplicates.
+fn emails(db: &Db, member_id: Option<&str>) -> Result<BTreeMap<String, BTreeSet<String>>> {
+    let id_pattern = match member_id {
+        Some(id) => format!("has member-id {}, has member-id $member_id", quote(id)),
+        None => "has member-id $member_id".to_owned(),
+    };
+    let rows = db.read_rows(&format!(
+        "
+        match
+          $m isa member, {id_pattern}, has email $email;
+        "
+    ))?;
+    let mut emails: BTreeMap<String, BTreeSet<String>> = BTreeMap::new();
+    for row in &rows {
+        let id = row.get("member_id")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("member_id", "string"))?
+            .to_owned();
+        let email = row.get("email")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("email", "string"))?
+            .to_owned();
+        emails.entry(id).or_default().insert(email);
+    }
+    Ok(emails)
+}
