+/// Every email address of the members (or of one member), keyed by member id. Each list is sorted and
+/// without duplicates. Members without email are absent from the map.
+///
+/// Emails are read in their own query: a member's email is multi-valued, so joining it into the member
+/// queries would return one row per address.
+fn emails_by_member(db: &Db, member_id: Option<&str>) -> Result<BTreeMap<String, Vec<String>>> {
+    let filter = member_id.map(|id| format!(", has member-id {}", quote(id))).unwrap_or_default();
+    let rows = db.read_rows(&format!("match $m isa member, has member-id $member_id{filter}, has email $email;"))?;
+    let mut map: BTreeMap<String, BTreeSet<String>> = BTreeMap::new();
+    for row in &rows {
+        let id = row.get("member_id")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("member_id", "string"))?;
+        let email = row.get("email")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("email", "string"))?;
+        map.entry(id.to_owned()).or_default().insert(email.to_owned());
+    }
+    Ok(map.into_iter().map(|(id, emails)| (id, emails.into_iter().collect())).collect())
+}
