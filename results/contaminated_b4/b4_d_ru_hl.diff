+/// The member's addresses from the `;`-separated `email` field: trimmed, sorted, without duplicates.
+fn emails(record: &Record) -> Vec<String> {
+    let mut addresses: Vec<String> = optional(record, "email")
+        .unwrap_or("")
+        .split(';')
+        .map(str::trim)
+        .filter(|address| !address.is_empty())
+        .map(str::to_owned)
+        .collect();
+    addresses.sort();
+    addresses.dedup();
+    addresses
+}
