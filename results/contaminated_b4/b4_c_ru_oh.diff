+/// Sort genres alphabetically and drop duplicates.
+fn normalise_genres(genres: &mut Vec<String>) {
+    genres.sort_unstable();
+    genres.dedup();
+}
+
+/// A query returns one row per genre of a book: merge the rows of each book (by ISBN) into a single item that
+/// carries all of the book's genres, keeping the first row's other columns.
+fn merge_genres<T>(items: Vec<T>, summary: impl Fn(&mut T) -> &mut BookSummary) -> Vec<T> {
+    let mut index: HashMap<String, usize> = HashMap::new();
+    let mut merged: Vec<T> = Vec::new();
+    for mut item in items {
+        let (isbn, genres) = {
+            let book = summary(&mut item);
+            (book.isbn.clone(), std::mem::take(&mut book.genres))
+        };
+        match index.get(&isbn) {
+            Some(&position) => summary(&mut merged[position]).genres.extend(genres),
+            None => {
+                summary(&mut item).genres = genres;
+                index.insert(isbn, merged.len());
+                merged.push(item);
+            }
+        }
+    }
+    for item in &mut merged {
+        normalise_genres(&mut summary(item).genres);
+    }
+    merged
+}
