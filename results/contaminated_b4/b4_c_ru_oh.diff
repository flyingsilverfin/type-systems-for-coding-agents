+/// The `genre` column of a row, if bound.
+fn optional_genre(row: &ConceptRow) -> Result<Option<String>> {
+    row.get("genre")?
+        .map(|concept| concept.try_get_string().map(str::to_owned).ok_or_else(|| AppError::column("genre", "string")))
