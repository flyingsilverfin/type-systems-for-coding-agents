+def _row_genre(row: ConceptRow) -> Optional[str]:
+    genre: Optional[str] = None
+    if (concept := row.get("g")) is not None and (genre := concept.try_get_string()) is None:
+        raise DataError("$g: expected a string")
+    return genre
+
+
+def _sorted_genres(genres: set[str]) -> tuple[str, ...]:
+    return tuple(sorted(genres))
+
+
+def _listings(rows: list[ConceptRow], needle: Optional[str] = None, has_genre: bool = True) -> list[BookListing]:
+    """Group rows (one per book and genre, `$g` optional) into one listing per book.
+
+    `has_genre` is False when the query has no `$g` variable at all (books known to have no genre).
+    With `needle`, keep only books whose title or optional subtitle `$s` contains it, ignoring case."""
+    order: list[str] = []
+    info: dict[str, tuple[str, int, bool]] = {}
+    genres: dict[str, set[str]] = {}
+    for row in rows:
+        if (concept := row.get("isbn")) is None or (isbn := concept.try_get_string()) is None:
+            raise DataError("$isbn: expected a string")
+        if isbn not in info:
+            if (concept := row.get("t")) is None or (title := concept.try_get_string()) is None:
+                raise DataError("$t: expected a string")
+            if (concept := row.get("y")) is None or (year := concept.try_get_integer()) is None:
+                raise DataError("$y: expected an integer")
+            keep = True
+            if needle is not None:
+                subtitle: Optional[str] = None
+                if (concept := row.get("s")) is not None and (subtitle := concept.try_get_string()) is None:
+                    raise DataError("$s: expected a string")
+                keep = needle in title.lower() or (subtitle is not None and needle in subtitle.lower())
+            info[isbn] = (title, year, keep)
+            genres[isbn] = set()
+            order.append(isbn)
+        if has_genre and (genre := _row_genre(row)) is not None:
+            genres[isbn].add(genre)
+    return [
+        BookListing(isbn=isbn, title=info[isbn][0], year=info[isbn][1], genres=_sorted_genres(genres[isbn]))
+        for isbn in order
+        if info[isbn][2]
+    ]
+
+
