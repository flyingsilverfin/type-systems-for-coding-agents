+class _HasDue(Protocol):
+    @property
+    def due(self) -> date: ...
+
+    @property
+    def renewed(self) -> Optional[date]: ...
+
+
+class EffectiveDue:
+    """For any loan-shaped type with `due` and `renewed` dates: the renewed date wins over the original due date."""
+
+    @property
+    def effective_due(self: _HasDue) -> date:
+        return self.renewed if self.renewed is not None else self.due
+
+    def is_renewed(self: _HasDue) -> bool:
+        return self.renewed is not None
+
+
