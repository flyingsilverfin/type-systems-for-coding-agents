+/// Every member's email addresses, sorted and without duplicates, keyed by member id.
+/// With `member_id` set, only that member's addresses are read.
+fn emails_of(db: &Db, member_id: Option<&str>) -> Result<BTreeMap<String, BTreeSet<String>>> {
+    let filter = member_id.map(|id| format!(", has member-id {}", quote(id))).unwrap_or_default();
+    let rows = db.read_rows(&format!(
+        "
+        match
+          $m isa member, has member-id $member_id, has email $email{filter};
+        "
+    ))?;
+    let mut emails: BTreeMap<String, BTreeSet<String>> = BTreeMap::new();
+    for row in &rows {
+        let id = row.get("member_id")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("member_id", "string"))?;
+        let email = row.get("email")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("email", "string"))?;
+        emails.entry(id.to_owned()).or_default().insert(email.to_owned());
+    }
+    Ok(emails)
+}
+
+fn sorted(set: Option<&BTreeSet<String>>) -> Vec<String> {
+    set.map(|set| set.iter().cloned().collect()).unwrap_or_default()
+}
