+def get_date(concept: Concept) -> Optional[date]:
+    """The date value of a concept as a `datetime.date`, or None if it is not a date.
+
+    Since driver 3.13, `try_get_date` returns the driver's `Date`, which has no ordering or arithmetic.
+    """
+    value = concept.try_get_date()
+    return None if value is None else value.to_date()
+
+
 def quote(value: str) -> str:
     """Render a Python string as a TypeQL string literal."""
     escaped = value.replace("\\", "\\\\").replace('"', '\\"')
