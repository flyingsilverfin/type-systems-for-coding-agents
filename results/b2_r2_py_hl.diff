@@ -0,0 +1,18 @@
+"""Member ids: stored as integers in the database, shown and accepted as M followed by digits (M001 -> 1)."""
+from __future__ import annotations
+
+import re
+from typing import Optional
+
+_MEMBER_ID = re.compile(r"M([0-9]+)")
+
+
+def member_key(text: str) -> Optional[int]:
+    """The integer stored for a member id such as M001, or None if the text is not M followed by digits."""
+    match = _MEMBER_ID.fullmatch(text)
+    return int(match.group(1)) if match else None
+
+
+def format_member_id(key: int) -> str:
+    """The member id shown to users, e.g. 7 -> M007."""
+    return f"M{key:03d}"
