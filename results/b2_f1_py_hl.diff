+def borrowers(isbn: str, rows: list[MemberName]) -> list[str]:
+    counts = Counter(row.id for row in rows)
+    names = {row.id: row.name for row in rows}
+    ranked = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
+    lines = [f"borrowers {isbn}: {len(ranked)} members"]
+    lines += [f"  {mid} {names[mid]} ({count} loans)" for mid, count in ranked]
+    return lines
+
