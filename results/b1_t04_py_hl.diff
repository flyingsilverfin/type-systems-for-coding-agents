 def all_loans(db: Db) -> list[Loan]:
     return _loans(db)
+
+
+def fees_by_member(db: Db) -> list[tuple[str, str, int]]:
+    """(member id, member name, total fee cents) for every member with at least one fee."""
+    rows = db.read_rows("""
+        match
+          $m isa member, has member-id $mid, has name $n;
+          $l isa loan, links (borrower: $m), has fee-cents $fc;
+    """)
+    totals: dict[tuple[str, str], int] = {}
+    for row in rows:
+        key = (req_string(row, "mid"), req_string(row, "n"))
+        totals[key] = totals.get(key, 0) + req_integer(row, "fc")
+    return [(mid, name, cents) for (mid, name), cents in totals.items()]
diff --git a/app/lending/report.py b/app/lending/report.py
index 69a91e5..6b9aff7 100644
--- a/app/lending/report.py
+++ b/app/lending/report.py
@@ -42,3 +42,12 @@ def genre_stats(items: list[Book]) -> list[str]:
     counts = Counter(b.genre if b.genre is not None else "(none)" for b in items)
     ordered = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
     return [f"{genre}: {count}" for genre, count in ordered]
+
+
+def fees(items: list[tuple[str, str, int]]) -> list[str]:
+    ordered = sorted(items, key=lambda t: (-t[2], t[0]))
+    return [
+        f"{mid} {name} {cents // 100}.{cents % 100:02d}"
+        for mid, name, cents in ordered
+        if cents > 0
+    ]
