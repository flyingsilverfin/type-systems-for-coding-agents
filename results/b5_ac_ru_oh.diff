+/// Group book rows (one row per combination of a book's optional attribute values) into one summary per book,
+/// keyed by ISBN, together with the book's subtitle when the rows carry one.
+fn summarise(rows: &[ConceptRow]) -> Result<Vec<(BookSummary, Option<String>)>> {
+    let mut by_isbn: BTreeMap<String, (BookSummary, BTreeSet<String>, Option<String>)> = BTreeMap::new();
+    for row in rows {
+        let isbn = row.get("isbn")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("isbn", "string"))?
+            .to_owned();
+        let entry = match by_isbn.entry(isbn) {
+            Entry::Occupied(entry) => entry.into_mut(),
+            Entry::Vacant(entry) => {
+                let summary = BookSummary {
+                    isbn: entry.key().clone(),
+                    title: row.get("title")?
+                        .and_then(Concept::try_get_string)
+                        .ok_or_else(|| AppError::column("title", "string"))?
+                        .to_owned(),
+                    year: if has_column(row, "year") { optional_integer(row, "year")? } else { None },
+                    genres: Vec::new(),
+                };
+                entry.insert((summary, BTreeSet::new(), None))
+            }
+        };
+        if has_column(row, "genre") {
+            if let Some(genre) = optional_string(row, "genre")? {
+                entry.1.insert(genre);
+            }
+        }
+        if entry.2.is_none() && has_column(row, "subtitle") {
+            entry.2 = optional_string(row, "subtitle")?;
+        }
+    }
+    Ok(by_isbn
+        .into_values()
+        .map(|(mut summary, genres, subtitle)| {
+            summary.genres = genres.into_iter().collect();
+            (summary, subtitle)
+        })
+        .collect())
+}
+
+/// Whether the query that produced `row` has the column at all (not every listing query asks for every column).
+fn has_column(row: &ConceptRow, column: &str) -> bool {
+    row.get_column_names().iter().any(|name| name == column)
+}
+
+fn optional_string(row: &ConceptRow, column: &str) -> Result<Option<String>> {
+    row.get(column)?
+        .map(|concept| concept.try_get_string().map(str::to_owned).ok_or_else(|| AppError::column(column, "string")))
+        .transpose()
+}
+
+fn optional_integer(row: &ConceptRow, column: &str) -> Result<Option<i64>> {
+    row.get(column)?
+        .map(|concept| concept.try_get_integer().ok_or_else(|| AppError::column(column, "integer")))
+        .transpose()
+}
+
+fn summaries(rows: &[ConceptRow]) -> Result<Vec<BookSummary>> {
+    Ok(summarise(rows)?.into_iter().map(|(summary, _)| summary).collect())
+}
