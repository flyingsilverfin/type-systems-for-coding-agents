 """Thin wrapper around the TypeDB driver: connection, schema setup, write and read transactions."""
 from __future__ import annotations
 
+from datetime import date
+from typing import Optional
+
 from typedb.driver import (
+    Concept,
     ConceptRow,
     Credentials,
     DriverOptions,
@@ -64,3 +68,9 @@ def quote(value: str) -> str:
     escaped = value.replace("\\", "\\\\").replace('"', '\\"')
     return f'"{escaped}"'
 
+
+
+def date_value(concept: Concept) -> Optional[date]:
+    """The concept's date value as a `datetime.date` (the driver returns its own `Date` since 3.13), or None."""
+    value = concept.try_get_date()
+    return value.to_date() if value is not None else None
