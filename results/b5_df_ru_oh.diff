+/// The email addresses of one member (or of all members), keyed by member id; each list is sorted and deduplicated.
+fn emails(db: &Db, member_id: Option<&str>) -> Result<BTreeMap<String, Vec<String>>> {
+    let id_pattern = match member_id {
+        Some(id) => format!("has member-id {}", quote(id)),
+        None => "has member-id $member_id".to_owned(),
+    };
+    let rows = db.read_rows(&format!(
+        "
+        match
+          $m isa member, {id_pattern}, has email $email;
+        "
+    ))?;
+    let mut sets: BTreeMap<String, BTreeSet<String>> = BTreeMap::new();
+    for row in &rows {
+        let id = match member_id {
+            Some(id) => id.to_owned(),
+            None => row.get("member_id")?
+                .and_then(Concept::try_get_string)
+                .ok_or_else(|| AppError::column("member_id", "string"))?
+                .to_owned(),
+        };
+        let email = row.get("email")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("email", "string"))?
+            .to_owned();
+        sets.entry(id).or_default().insert(email);
+    }
+    Ok(sets.into_iter().map(|(id, set)| (id, set.into_iter().collect())).collect())
+}
