+def book_borrowings(db: Db, isbn: str) -> Optional[list[BookBorrowing]]:
+    """Every loan of the book (open, returned or lost) with its borrower, or None if there is no such book."""
+    rows = db.read_rows(f"""
+        match
+          $b isa book, has isbn {quote(isbn)};
+          try {{
+            $l isa loan, links (borrower: $m, item: $b), has loan-id $lid;
+            $m has member-id $mid, has name $n;
+          }};
+    """)
+    if not rows:
+        return None
+    borrowings: list[BookBorrowing] = []
+    for row in rows:
+        if row.get("l") is None:
+            continue  # the book exists but has never been borrowed
+        if (concept := row.get("lid")) is None or (loan_id := concept.try_get_string()) is None:
+            raise DataError("$lid: expected a string")
+        if (concept := row.get("mid")) is None or (member_id := concept.try_get_string()) is None:
+            raise DataError("$mid: expected a string")
+        if (concept := row.get("n")) is None or (name := concept.try_get_string()) is None:
+            raise DataError("$n: expected a string")
+        borrowings.append(BookBorrowing(loan_id=loan_id, member_id=member_id, name=name))
+    return borrowings
+
+
