+def borrowers(isbn: str, items: list[BookBorrowing]) -> list[str]:
+    loan_ids: dict[str, set[str]] = {}
+    names: dict[str, str] = {}
+    for item in items:
+        loan_ids.setdefault(item.member_id, set()).add(item.loan_id)
+        names[item.member_id] = item.name
+    ranked = sorted(((mid, len(ids)) for mid, ids in loan_ids.items()), key=lambda kv: (-kv[1], kv[0]))
+    lines = [f"borrowers {isbn}: {len(ranked)} members"]
+    lines += [f"  {mid} {names[mid]} ({count} loans)" for mid, count in ranked]
+    return lines
+
+
