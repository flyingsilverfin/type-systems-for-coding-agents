+def top_borrowers(loans: list[Loan], names: dict[str, str], n: int) -> list[str]:
+    counts = Counter(loan.member_id for loan in loans)
+    ordered = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[:n]
+    return [
+        f"{rank}. {member_id} {names.get(member_id, NONE)} ({count} loans)"
+        for rank, (member_id, count) in enumerate(ordered, start=1)
+    ]
