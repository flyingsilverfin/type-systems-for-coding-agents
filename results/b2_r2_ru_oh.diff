+/// Parse a member id as written in the CSV files and on the command line (`M` followed by digits, e.g. `M042`)
+/// into the numeric key stored in the database. Anything else is `None`.
+pub fn parse_member_id(text: &str) -> Option<i64> {
+    let digits = text.strip_prefix('M')?;
+    if digits.is_empty() || !digits.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    digits.parse::<i64>().ok()
+}
+
+/// Render a numeric member id in its user-facing form: `M` followed by (at least) three digits.
+pub fn format_member_id(id: i64) -> String {
+    format!("M{id:03}")
+}
