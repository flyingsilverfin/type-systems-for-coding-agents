+def search_books(db: Db) -> list[Book]:
+    """All books with their optional subtitle, for text search in the caller."""
+    rows = db.read_rows("""
+        match
+          $b isa book, has isbn $isbn, has title $t, has year $y, has copies $c;
+          try { $b has genre $g; };
+          try { $b has subtitle $s; };
+    """)
+    return [
+        Book(
+            isbn=req_string(row, "isbn"),
+            title=req_string(row, "t"),
+            year=req_integer(row, "y"),
+            genre=string(row, "g"),
+            copies=req_integer(row, "c"),
+            subtitle=string(row, "s"),
+        )
+        for row in rows
+    ]
+
