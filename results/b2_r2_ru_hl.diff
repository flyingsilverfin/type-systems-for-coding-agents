@@ -1,5 +1,19 @@
 use chrono::NaiveDate;
 
+/// The integer stored for a member id such as `M001`; `None` if `text` is not `M` followed by digits.
+pub fn member_key(text: &str) -> Option<i64> {
+    let digits = text.strip_prefix('M')?;
+    if digits.is_empty() || !digits.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    digits.parse::<i64>().ok()
+}
+
+/// The id printed for a stored member key, in the form `M` followed by at least three digits (e.g. `M007`).
+pub fn member_code(key: i64) -> String {
+    format!("M{key:03}")
+}
+
