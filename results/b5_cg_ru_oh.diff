+
+/// Fold rows that each carry a book's listing columns and an optional `$genre` (and, when `with_subtitle`, an
+/// optional `$subtitle`) into one summary (and subtitle) per book: a book with several genres comes back as
+/// several rows.
+fn summaries(rows: &[ConceptRow], with_subtitle: bool) -> Result<Vec<(BookSummary, Option<String>)>> {
+    let mut by_isbn: BTreeMap<String, (BookSummary, Option<String>)> = BTreeMap::new();
+    for row in rows {
+        let isbn = required_string(row, "isbn")?;
+        let genre = optional_string(row, "genre")?;
+        let subtitle = if with_subtitle { optional_string(row, "subtitle")? } else { None };
+        let entry = match by_isbn.entry(isbn) {
+            Entry::Occupied(entry) => entry.into_mut(),
+            Entry::Vacant(entry) => {
+                let summary = BookSummary {
+                    isbn: entry.key().clone(),
+                    title: required_string(row, "title")?,
+                    year: required_integer(row, "year")?,
+                    genres: Vec::new(),
+                };
+                entry.insert((summary, None))
+            }
+        };
+        entry.0.genres.extend(genre);
+        if entry.1.is_none() {
+            entry.1 = subtitle;
+        }
+    }
+    let mut books: Vec<(BookSummary, Option<String>)> = by_isbn.into_values().collect();
+    for (book, _) in &mut books {
+        normalise(&mut book.genres);
+    }
+    Ok(books)
+}
