diff --git a/app/lending/memberid.py b/app/lending/memberid.py
new file mode 100644
index 0000000..f421d77
--- /dev/null
+++ b/app/lending/memberid.py
@@ -0,0 +1,27 @@
+"""Member ids: `M` followed by digits outside the database (CLI, CSV, output); an integer `member-id` inside it."""
+from __future__ import annotations
+
+import re
+from typing import Optional
+
+_PATTERN = re.compile(r"M[0-9]+")
+_MAX_KEY = 2**63 - 1  # largest TypeDB integer
+
+
+def member_key(text: str) -> Optional[int]:
+    """The integer stored for a member id such as `M001` (1), or None if the text is not a valid member id."""
+    if _PATTERN.fullmatch(text) is None:
+        return None
+    key = int(text[1:])
+    return key if key <= _MAX_KEY else None
+
+
+def member_text(key: int) -> str:
+    """The printed form of a stored member key: `M` and at least three digits."""
+    return f"M{key:03d}"
+
+
+def member_text_of(concept) -> Optional[str]:
+    """The printed member id for a `member-id` concept read from the database, or None if it is not an integer."""
+    key = concept.try_get_integer()
+    return None if key is None else member_text(key)
