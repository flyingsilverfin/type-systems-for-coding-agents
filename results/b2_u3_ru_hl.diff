     format!("\"{}\"", value.replace('\\', "\\\\").replace('"', "\\\""))
 }
+
+/// The date value of a concept, as a `chrono` date (the driver's `Date` type has no arithmetic or ordering).
+pub fn naive_date(concept: &Concept) -> Option<NaiveDate> {
+    concept.try_get_date().map(|date| date.to_naive_date())
+}
