+/// The distinct genres of a `genre` field (separated by `;`), in alphabetical order.
+fn genres_of(text: &str) -> BTreeSet<&str> {
+    text.split(';').map(str::trim).filter(|genre| !genre.is_empty()).collect()
+}
+
 pub fn book_query(record: &Record, line: usize) -> Result<String> {
     let f = "books.csv";
     let isbn = field(record, "isbn", f, line)?;
     let title = field(record, "title", f, line)?;
-    let year = parse_int(field(record, "year", f, line)?, f, line)?;
+    let year = optional(record, "year").map(|text| parse_int(text, f, line)).transpose()?;
     let copies = parse_int(field(record, "copies", f, line)?, f, line)?;
     let mut parts = vec![format!(
-        "$b isa book, has isbn {}, has title {}, has year {year}, has copies {copies}",
+        "$b isa book, has isbn {}, has title {}, has copies {copies}",
         quote(isbn),
         quote(title)
     )];
+    if let Some(year) = year {
+        parts.push(format!("has year {year}"));
+    }
     if let Some(subtitle) = optional(record, "subtitle") {
         parts.push(format!("has subtitle {}", quote(subtitle)));
     }
     if let Some(genre) = optional(record, "genre") {
-        parts.push(format!("has genre {}", quote(genre)));
+        for name in genres_of(genre) {
+            parts.push(format!("has genre {}", quote(name)));
+        }
     }
     Ok(format!("insert {};", parts.join(", ")))
 }
