index 6e6e2b9..2235f38 100644
--- a/app/src/repo/mod.rs
+++ b/app/src/repo/mod.rs
@@ -1,8 +1,165 @@
-//! Read-side queries: one function per CLI command, each with its own TypeQL query.
+//! Read-side queries: one function per CLI command, built on a few shared TypeQL queries.
 //!
-//! Commands whose output depends on loan status return `model::Loan`, so the status rules live in one
-//! place; the others return small purpose-built rows holding only the columns the command needs.
-//! Column values are extracted inline with `ConceptRow::get` and the `Concept::try_get_*` accessors.
+//! Books and members own multi-valued attributes (genres, emails), so their queries return one row per
+//! value; the shared readers below merge those rows into one `model::Book` / `model::Member` per key, so no
+//! command can list a book or member twice. Commands whose output depends on loan status return
+//! `model::Loan`, so the status rules live in one place.
 pub mod books;
 pub mod loans;
 pub mod members;
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use chrono::NaiveDate;
+use typedb_driver::{answer::ConceptRow, concept::Concept};
+
+use crate::{
+    db::Db,
+    error::{AppError, Result},
+    model::{Book, Loan, Member},
+};
+
+pub(crate) fn opt_string(row: &ConceptRow, var: &str) -> Result<Option<String>> {
+    row.get(var)?
+        .map(|concept| concept.try_get_string().map(str::to_owned).ok_or_else(|| AppError::column(var, "string")))
+        .transpose()
+}
+
+pub(crate) fn req_string(row: &ConceptRow, var: &str) -> Result<String> {
+    opt_string(row, var)?.ok_or_else(|| AppError::column(var, "string"))
+}
+
+pub(crate) fn opt_integer(row: &ConceptRow, var: &str) -> Result<Option<i64>> {
+    row.get(var)?.map(|concept| concept.try_get_integer().ok_or_else(|| AppError::column(var, "integer"))).transpose()
+}
+
+pub(crate) fn req_integer(row: &ConceptRow, var: &str) -> Result<i64> {
+    opt_integer(row, var)?.ok_or_else(|| AppError::column(var, "integer"))
+}
+
+pub(crate) fn opt_date(row: &ConceptRow, var: &str) -> Result<Option<NaiveDate>> {
+    row.get(var)?.map(|concept| Concept::try_get_date(concept).ok_or_else(|| AppError::column(var, "date"))).transpose()
+}
+
+pub(crate) fn req_date(row: &ConceptRow, var: &str) -> Result<NaiveDate> {
+    opt_date(row, var)?.ok_or_else(|| AppError::column(var, "date"))
+}
+
+/// Books matching `constraint` (extra TypeQL statements about `$b`), one per ISBN, ordered by ISBN.
+pub(crate) fn read_books(db: &Db, constraint: &str) -> Result<Vec<Book>> {
+    let rows = db.read_rows(&format!(
+        "
+        match
+          $b isa book, has isbn $isbn, has title $title, has copies $copies;
+          {constraint}
+          try {{ $b has subtitle $subtitle; }};
+          try {{ $b has year $year; }};
+          try {{ $b has genre $genre; }};
+        "
+    ))?;
+    let mut books: BTreeMap<String, (Book, BTreeSet<String>)> = BTreeMap::new();
+    for row in &rows {
+        let isbn = req_string(row, "isbn")?;
+        let genre = opt_string(row, "genre")?;
+        let entry = match books.get_mut(&isbn) {
+            Some(entry) => entry,
+            None => {
+                let book = Book {
+                    isbn: isbn.clone(),
+                    title: req_string(row, "title")?,
+                    subtitle: opt_string(row, "subtitle")?,
+                    year: opt_integer(row, "year")?,
+                    genres: Vec::new(),
+                    copies: req_integer(row, "copies")?,
+                };
+                books.entry(isbn).or_insert((book, BTreeSet::new()))
+            }
+        };
+        entry.1.extend(genre);
+    }
+    Ok(books
+        .into_values()
+        .map(|(mut book, genres)| {
+            book.genres = genres.into_iter().collect();
+            book
+        })
+        .collect())
+}
+
+/// Members matching `constraint` (extra TypeQL statements about `$m`), one per member id, ordered by id.
+pub(crate) fn read_members(db: &Db, constraint: &str) -> Result<Vec<Member>> {
+    let rows = db.read_rows(&format!(
+        "
+        match
+          $m isa member, has member-id $member_id, has name $name, has joined $joined;
+          {constraint}
+          try {{ $m has phone $phone; }};
+          try {{ $m has email $email; }};
+        "
+    ))?;
+    let mut members: BTreeMap<String, (Member, BTreeSet<String>)> = BTreeMap::new();
+    for row in &rows {
+        let id = req_string(row, "member_id")?;
+        let email = opt_string(row, "email")?;
+        let entry = match members.get_mut(&id) {
+            Some(entry) => entry,
+            None => {
+                let member = Member {
+                    id: id.clone(),
+                    name: req_string(row, "name")?,
+                    emails: Vec::new(),
+                    phone: opt_string(row, "phone")?,
+                    joined: req_date(row, "joined")?,
+                };
+                members.entry(id).or_insert((member, BTreeSet::new()))
+            }
+        };
+        entry.1.extend(email);
+    }
+    Ok(members
+        .into_values()
+        .map(|(mut member, emails)| {
+            member.emails = emails.into_iter().collect();
+            member
+        })
+        .collect())
+}
+
+/// Loans matching `constraint` (extra TypeQL statements about `$l`, `$m`, `$b`, `$member_id`, `$isbn`),
+/// one per loan id, ordered by loan id.
+pub(crate) fn read_loans(db: &Db, constraint: &str) -> Result<Vec<Loan>> {
+    let rows = db.read_rows(&format!(
+        "
+        match
+          $l isa loan, links (borrower: $m, item: $b), has loan-id $loan_id, has borrowed $borrowed;
+          $m has member-id $member_id;
+          $b has isbn $isbn;
+          {constraint}
+          try {{ $l has due $due; }};
+          try {{ $l has renewed $renewed; }};
+          try {{ $l has returned $returned; }};
+          try {{ $l has lost $lost; }};
+          try {{ $l has fee-cents $fee; }};
+        "
+    ))?;
+    let mut loans: BTreeMap<String, Loan> = BTreeMap::new();
+    for row in &rows {
+        let id = req_string(row, "loan_id")?;
+        if loans.contains_key(&id) {
+            continue;
+        }
+        let loan = Loan {
+            id: id.clone(),
+            member_id: req_string(row, "member_id")?,
+            isbn: req_string(row, "isbn")?,
+            borrowed: req_date(row, "borrowed")?,
+            due: opt_date(row, "due")?,
+            renewed: opt_date(row, "renewed")?,
+            returned: opt_date(row, "returned")?,
+            lost: opt_date(row, "lost")?,
+            fee_cents: opt_integer(row, "fee")?,
+        };
+        loans.insert(id, loan);
+    }
+    Ok(loans.into_values().collect())
+}
