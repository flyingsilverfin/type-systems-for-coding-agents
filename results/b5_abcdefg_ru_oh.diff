+/// The distinct non-empty values of a `;`-separated multi-valued field, sorted.
+fn multi<'a>(record: &'a Record, key: &str) -> Vec<&'a str> {
+    let mut values: Vec<&str> =
+        optional(record, key).map(|text| text.split(';').map(str::trim).filter(|v| !v.is_empty()).collect()).unwrap_or_default();
+    values.sort_unstable();
+    values.dedup();
+    values
+}
