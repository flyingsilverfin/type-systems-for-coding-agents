+++ b/app/src/repo.rs
@@ -75,3 +75,17 @@ pub fn loans_for_member(db: &Db, member_id: &str) -> Result<Vec<Loan>> {
 pub fn all_loans(db: &Db) -> Result<Vec<Loan>> {
     loans(db, "")
 }
+
+/// One (member id, member name, fee in cents) row per loan that carries a fee.
+pub fn fee_rows(db: &Db) -> Result<Vec<(String, String, i64)>> {
+    let rows = db.read_rows(
+        "
+        match
+          $l isa loan, links (borrower: $m), has fee-cents $f;
+          $m has member-id $mid, has name $n;
+        ",
+    )?;
+    rows.iter()
+        .map(|row| Ok((req_string(row, "mid")?, req_string(row, "n")?, req_integer(row, "f")?)))
+        .collect()
+}
diff --git a/app/src/report.rs b/app/src/report.rs
index c094d79..6b5f0d5 100644
--- a/app/src/report.rs
+++ b/app/src/report.rs
@@ -60,3 +60,19 @@ pub fn genre_stats(items: &[Book]) -> Vec<String> {
     ordered.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(b.0)));
     ordered.iter().map(|(genre, count)| format!("{genre}: {count}")).collect()
 }
+
+/// Total fees per member (members with a total above zero only), by total descending then member id.
+pub fn fees(rows: &[(String, String, i64)]) -> Vec<String> {
+    let mut totals: BTreeMap<&str, (&str, i64)> = BTreeMap::new();
+    for (id, name, cents) in rows {
+        let entry = totals.entry(id.as_str()).or_insert((name.as_str(), 0));
+        entry.1 += cents;
+    }
+    let mut ordered: Vec<(&str, &str, i64)> =
+        totals.into_iter().filter(|(_, (_, total))| *total > 0).map(|(id, (name, total))| (id, name, total)).collect();
+    ordered.sort_by(|a, b| b.2.cmp(&a.2).then(a.0.cmp(b.0)));
+    ordered
+        .iter()
+        .map(|(id, name, total)| format!("{id} {name} {}.{:02}", total / 100, total % 100))
+        .collect()
+}
