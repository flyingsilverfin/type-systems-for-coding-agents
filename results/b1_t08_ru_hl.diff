+    }
+}
+
+/// Rows of a read query, produced one at a time while the transaction is open.
+pub struct RowStream {
+    // Declared before `_tx` so the row stream is dropped before its transaction.
+    rows: BoxStream<'static, typedb_driver::Result<ConceptRow>>,
+    _tx: Transaction,
+}
+
+impl Iterator for RowStream {
+    type Item = Result<ConceptRow>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        self.rows.next().map(|row| row.map_err(AppError::from))
     }
 }
 
