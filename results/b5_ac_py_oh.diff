+def _optional_year(row: ConceptRow) -> Optional[int]:
+    year: Optional[int] = None
+    if (concept := row.get("y")) is not None and (year := concept.try_get_integer()) is None:
+        raise DataError("$y: expected an integer")
+    return year
+
+
+def _optional_genre(row: ConceptRow) -> Optional[str]:
+    genre: Optional[str] = None
+    if (concept := row.get("g")) is not None and (genre := concept.try_get_string()) is None:
+        raise DataError("$g: expected a string")
+    return genre
+
+
+def _listings(rows: list[ConceptRow], keep: Optional[Callable[[ConceptRow], bool]] = None) -> list[BookListing]:
+    """Group rows (one per book and genre) into one listing per book, with its genres sorted and distinct.
+
+    Rows bind $isbn, $t and optionally $y and $g. `keep`, if given, filters books on their first row."""
+    titles: dict[str, str] = {}
+    years: dict[str, Optional[int]] = {}
+    genres: dict[str, set[str]] = {}
+    for row in rows:
+        if (concept := row.get("isbn")) is None or (isbn := concept.try_get_string()) is None:
+            raise DataError("$isbn: expected a string")
+        if isbn not in titles:
+            if keep is not None and not keep(row):
+                continue
+            if (concept := row.get("t")) is None or (title := concept.try_get_string()) is None:
+                raise DataError("$t: expected a string")
+            titles[isbn] = title
+            years[isbn] = _optional_year(row)
+            genres[isbn] = set()
+        if (genre := _optional_genre(row)) is not None:
+            genres[isbn].add(genre)
+    return [
+        BookListing(isbn=isbn, title=title, year=years[isbn], genres=tuple(sorted(genres[isbn])))
+        for isbn, title in titles.items()
+    ]
+
