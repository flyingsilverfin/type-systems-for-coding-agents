+
+/// Every member who ever borrowed the book, with their number of loans of it: most loans first, then member id.
+pub fn borrowers(isbn: &str, loans: &[(String, MemberName)]) -> Vec<String> {
+    let mut seen: BTreeSet<&str> = BTreeSet::new();
+    let mut counts: BTreeMap<&str, (&str, usize)> = BTreeMap::new();
+    for (loan_id, member) in loans {
+        if seen.insert(loan_id) {
+            counts.entry(&member.id).or_insert((&member.name, 0)).1 += 1;
+        }
+    }
+    let mut ranked: Vec<(&str, &str, usize)> =
+        counts.into_iter().map(|(id, (name, count))| (id, name, count)).collect();
+    ranked.sort_by(|a, b| b.2.cmp(&a.2).then(a.0.cmp(b.0)));
+    let mut lines = vec![format!("borrowers {isbn}: {} members", ranked.len())];
+    lines.extend(ranked.iter().map(|(id, name, count)| format!("  {id} {name} ({count} loans)")));
+    lines
+}
