+
+/// One entry per loan of the book: the loan id with its borrower's id and name, or `None` if there is no such book.
+pub fn borrowers(db: &Db, isbn: &str) -> Result<Option<Vec<(String, MemberName)>>> {
+    let book_rows = db.read_rows(&format!(
+        "
+        match
+          $b isa book, has isbn {};
+        ",
+        quote(isbn)
+    ))?;
+    if book_rows.is_empty() {
+        return Ok(None);
+    }
+    let rows = db.read_rows(&format!(
+        "
+        match
+          $b isa book, has isbn {};
+          $l isa loan, links (borrower: $m, item: $b), has loan-id $loan_id;
+          $m has member-id $member_id, has name $name;
+        ",
+        quote(isbn)
+    ))?;
+    rows.iter()
+        .map(|row| {
+            let loan_id = row.get("loan_id")?
+                .and_then(Concept::try_get_string)
+                .ok_or_else(|| AppError::column("loan_id", "string"))?
+                .to_owned();
+            let member = MemberName {
+                id: row.get("member_id")?
+                    .and_then(Concept::try_get_string)
+                    .ok_or_else(|| AppError::column("member_id", "string"))?
+                    .to_owned(),
+                name: row.get("name")?
+                    .and_then(Concept::try_get_string)
+                    .ok_or_else(|| AppError::column("name", "string"))?
+                    .to_owned(),
+            };
+            Ok((loan_id, member))
+        })
+        .collect::<Result<Vec<_>>>()
+        .map(Some)
+}
