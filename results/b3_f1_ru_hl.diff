+
+/// Members who have ever borrowed the book, with their number of loans of it: most loans first, then member id.
+pub fn borrowers(isbn: &str, loans: &[MemberName]) -> Vec<String> {
+    let mut counts: BTreeMap<(&str, &str), usize> = BTreeMap::new();
+    for loan in loans {
+        *counts.entry((loan.id.as_str(), loan.name.as_str())).or_default() += 1;
+    }
+    let mut members: Vec<((&str, &str), usize)> = counts.into_iter().collect();
+    members.sort_by(|a, b| b.1.cmp(&a.1).then(a.0 .0.cmp(b.0 .0)));
+    let mut lines = vec![format!("borrowers {isbn}: {} members", members.len())];
+    lines.extend(
+        members.iter().map(|((id, name), count)| format!("  {id} {name} ({count} loans)")),
+    );
+    lines
+}
