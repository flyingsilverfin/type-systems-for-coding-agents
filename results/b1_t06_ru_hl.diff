+pub fn top(members: &[Member], loans: &[Loan], n: usize) -> Vec<String> {
+    let mut counts: BTreeMap<&str, usize> = BTreeMap::new();
+    for loan in loans {
+        *counts.entry(loan.member_id.as_str()).or_default() += 1;
+    }
+    let mut ranked: Vec<(&Member, usize)> =
+        members.iter().filter_map(|m| counts.get(m.id.as_str()).map(|&count| (m, count))).collect();
+    ranked.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.id.cmp(&b.0.id)));
+    ranked
+        .iter()
+        .take(n)
+        .enumerate()
+        .map(|(i, (m, count))| format!("{}. {} {} ({} loans)", i + 1, m.id, m.name, count))
+        .collect()
+}
