--- a/app/src/model.rs
+++ b/app/src/model.rs
@@ -17,6 +17,14 @@ pub struct Book {
     pub copies: i64,
 }
 
+/// The state of a loan: exactly one of these cases.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum LoanStatus {
+    Open,
+    Returned(NaiveDate),
+    Lost(NaiveDate),
+}
+
 #[derive(Debug, Clone, PartialEq)]
 pub struct Loan {
     pub id: String,
@@ -24,11 +32,24 @@ pub struct Loan {
     pub isbn: String,
     pub borrowed: NaiveDate,
     pub due: NaiveDate,
-    pub returned: Option<NaiveDate>,
+    pub status: LoanStatus,
 }
 
 impl Loan {
     pub fn is_open(&self) -> bool {
-        self.returned.is_none()
+        self.status == LoanStatus::Open
+    }
+
+    pub fn is_lost(&self) -> bool {
+        matches!(self.status, LoanStatus::Lost(_))
+    }
+}
+
+/// Build a status from optional return and lost dates. A lost date takes precedence.
+pub fn loan_status(returned: Option<NaiveDate>, lost: Option<NaiveDate>) -> LoanStatus {
+    match (lost, returned) {
+        (Some(date), _) => LoanStatus::Lost(date),
+        (None, Some(date)) => LoanStatus::Returned(date),
+        (None, None) => LoanStatus::Open,
     }
 }
