+def find_book(db: Db, isbn: str) -> Optional[Book]:
+    rows = db.read_rows(f"""
+        match
+          $b isa book, has isbn {quote(isbn)}, has title $t, has year $y, has copies $c;
+          try {{ $b has genre $g; }};
+    """)
+    if not rows:
+        return None
+    row = rows[0]
+    return Book(
+        isbn=isbn,
+        title=req_string(row, "t"),
+        year=req_integer(row, "y"),
+        genre=string(row, "g"),
+        copies=req_integer(row, "c"),
+    )
+
+
