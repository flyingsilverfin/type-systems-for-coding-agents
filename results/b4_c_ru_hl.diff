+fn integer(row: &ConceptRow, column: &str) -> Result<i64> {
+    row.get(column)?.and_then(Concept::try_get_integer).ok_or_else(|| AppError::column(column, "integer"))
+}
+
+/// Groups book rows (one row per genre a book has) into one entry per book, ordered by ISBN.
+/// Rows must bind `isbn`, `title`, `year` and `subtitle`; `genre` is bound when the book has one.
+/// The subtitle is returned alongside each book.
+fn group(rows: &[ConceptRow]) -> Result<Vec<(BookSummary, Option<String>)>> {
+    let mut books: BTreeMap<String, (BookSummary, Option<String>)> = BTreeMap::new();
+    for row in rows {
+        let isbn = text(row, "isbn")?;
+        let title = text(row, "title")?;
+        let year = integer(row, "year")?;
+        let subtitle = optional_text(row, "subtitle")?;
+        let genre = optional_text(row, "genre")?;
+        let entry = books
+            .entry(isbn.clone())
+            .or_insert_with(|| (BookSummary { isbn, title, year, genres: Vec::new() }, subtitle));
+        entry.0.genres.extend(genre);
+    }
+    Ok(books
+        .into_values()
+        .map(|(mut book, subtitle)| {
+            book.genres.sort();
+            book.genres.dedup();
+            (book, subtitle)
+        })
+        .collect())
+}
+
+fn summaries(rows: &[ConceptRow]) -> Result<Vec<BookSummary>> {
+    Ok(group(rows)?.into_iter().map(|(book, _)| book).collect())
+}
