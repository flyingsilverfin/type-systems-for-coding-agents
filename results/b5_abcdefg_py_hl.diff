     escaped = value.replace("\\", "\\\\").replace('"', '\\"')
     return f'"{escaped}"'
 
+
+
+_GETTERS = {"string": "try_get_string", "integer": "try_get_integer", "date": "try_get_date"}
+
+
+def opt(row: ConceptRow, name: str, kind: str) -> Any:
+    """The value bound to `$name` (of kind string, integer or date), or None if the variable is unbound."""
+    concept = row.get(name)
+    if concept is None:
+        return None
+    value = getattr(concept, _GETTERS[kind])()
+    if value is None:
+        raise DataError(f"${name}: expected a {kind}")
+    return value
+
+
+def req(row: ConceptRow, name: str, kind: str) -> Any:
+    """Like `opt`, but the variable must be bound."""
+    value = opt(row, name, kind)
+    if value is None:
+        raise DataError(f"${name}: expected a {kind}")
+    return value
