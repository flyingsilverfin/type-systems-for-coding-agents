+def _emails(db: Db, member_id: Optional[str] = None) -> dict[str, tuple[str, ...]]:
+    """Each member's email addresses (sorted, distinct), keyed by member id; all members, or one if given."""
+    scope = f"$m has member-id {quote(member_id)};" if member_id is not None else ""
+    rows = db.read_rows(f"""
+        match
+          $m isa member, has member-id $mid, has email $e;
+          {scope}
+    """)
+    found: dict[str, set[str]] = {}
+    for row in rows:
+        if (concept := row.get("mid")) is None or (mid := concept.try_get_string()) is None:
+            raise DataError("$mid: expected a string")
+        if (concept := row.get("e")) is None or (email := concept.try_get_string()) is None:
+            raise DataError("$e: expected a string")
+        found.setdefault(mid, set()).add(email)
+    return {mid: tuple(sorted(addresses)) for mid, addresses in found.items()}
+
