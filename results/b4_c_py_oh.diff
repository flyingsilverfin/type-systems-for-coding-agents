+def _listings(rows: list[ConceptRow], keep: Callable[[ConceptRow], bool] = lambda row: True) -> list[BookListing]:
+    """Book listings from rows with `$isbn`, `$t`, `$y` and optional `$g` columns.
+
+    A book with several genres appears in several rows; it yields one listing holding all its genres."""
+    found: dict[str, tuple[str, int]] = {}
+    genres: dict[str, set[str]] = {}
+    for row in rows:
+        if (concept := row.get("isbn")) is None or (isbn := concept.try_get_string()) is None:
+            raise DataError("$isbn: expected a string")
+        if not keep(row):
+            continue
+        if isbn not in found:
+            if (concept := row.get("t")) is None or (title := concept.try_get_string()) is None:
+                raise DataError("$t: expected a string")
+            if (concept := row.get("y")) is None or (year := concept.try_get_integer()) is None:
+                raise DataError("$y: expected an integer")
+            found[isbn] = (title, year)
+            genres[isbn] = set()
+        if (genre := _genre(row)) is not None:
+            genres[isbn].add(genre)
+    return [
+        BookListing(isbn=isbn, title=title, year=year, genres=tuple(sorted(genres[isbn])))
+        for isbn, (title, year) in found.items()
+    ]
+
