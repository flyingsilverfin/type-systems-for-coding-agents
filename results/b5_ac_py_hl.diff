 from lending.model import Book, BookAvailability, BookListing, BookLoan
 
 
+def _str(row, key: str, name: str) -> str:
+    if (concept := row.get(key)) is None or (value := concept.try_get_string()) is None:
+        raise DataError(f"${name}: expected a string")
+    return value
+
+
+def _opt_str(row, key: str, name: str) -> Optional[str]:
+    if (concept := row.get(key)) is None:
+        return None
+    if (value := concept.try_get_string()) is None:
+        raise DataError(f"${name}: expected a string")
+    return value
+
+
+def _opt_int(row, key: str, name: str) -> Optional[int]:
+    if (concept := row.get(key)) is None:
+        return None
+    if (value := concept.try_get_integer()) is None:
+        raise DataError(f"${name}: expected an integer")
+    return value
+
+
+def _listings(rows, needle: Optional[str] = None) -> list[BookListing]:
+    """Collapse rows (one per book and genre) into one BookListing per book.
+
+    Rows must carry $isbn, $t, optionally $y, $s (subtitle) and $g (one genre). When `needle` is given, only
+    books whose title or subtitle contains it (ignoring case) are kept.
+    """
+    collected: dict[str, tuple[str, Optional[int], set[str]]] = {}
+    for row in rows:
+        isbn = _str(row, "isbn", "isbn")
+        title = _str(row, "t", "t")
+        year = _opt_int(row, "y", "y")
+        subtitle = _opt_str(row, "s", "s")
+        genre = _opt_str(row, "g", "g")
+        if needle is not None and not (
+            needle in title.lower() or (subtitle is not None and needle in subtitle.lower())
+        ):
+            continue
+        _, _, genres = collected.setdefault(isbn, (title, year, set()))
+        if genre is not None:
+            genres.add(genre)
+    return [
+        BookListing(isbn=isbn, title=title, year=year, genres=tuple(sorted(genres)))
+        for isbn, (title, year, genres) in collected.items()
+    ]
+
+
