+/// The genres of every book that has at least one (or of the one book with `isbn`), keyed by ISBN,
+/// each sorted alphabetically and without duplicates.
+///
+/// Genres are fetched in their own query so that a book with several genres still yields a single
+/// row in the queries that list books.
+fn genres_of(db: &Db, isbn: Option<&str>) -> Result<HashMap<String, Vec<String>>> {
+    let isbn_constraint = match isbn {
+        Some(isbn) => format!("has isbn {}", quote(isbn)),
+        None => "has isbn $isbn".to_owned(),
+    };
+    let rows = db.read_rows(&format!(
+        "
+        match
+          $b isa book, {isbn_constraint}, has genre $genre;
+        "
+    ))?;
+    let mut genres: HashMap<String, Vec<String>> = HashMap::new();
+    for row in &rows {
+        let key = match isbn {
+            Some(isbn) => isbn.to_owned(),
+            None => row.get("isbn")?
+                .and_then(Concept::try_get_string)
+                .ok_or_else(|| AppError::column("isbn", "string"))?
+                .to_owned(),
+        };
+        let genre = row.get("genre")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("genre", "string"))?
+            .to_owned();
+        genres.entry(key).or_default().push(genre);
+    }
+    for list in genres.values_mut() {
+        list.sort_unstable();
+        list.dedup();
+    }
+    Ok(genres)
+}
+
+/// The listing columns of one row of a query binding `$isbn`, `$title` and `$year` (one row per book).
+fn summary(row: &ConceptRow, genres: &mut HashMap<String, Vec<String>>) -> Result<BookSummary> {
+    let isbn = row.get("isbn")?
+        .and_then(Concept::try_get_string)
+        .ok_or_else(|| AppError::column("isbn", "string"))?
+        .to_owned();
+    Ok(BookSummary {
+        title: row.get("title")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("title", "string"))?
+            .to_owned(),
+        year: row.get("year")?.and_then(Concept::try_get_integer).ok_or_else(|| AppError::column("year", "integer"))?,
+        genres: genres.remove(&isbn).unwrap_or_default(),
+        isbn,
+    })
+}
+
+/// Run a query binding `$isbn`, `$title` and `$year` once per book and attach each book's genres.
+fn summaries(db: &Db, query: &str) -> Result<Vec<BookSummary>> {
+    let rows = db.read_rows(query)?;
+    let mut genres = genres_of(db, None)?;
+    rows.iter().map(|row| summary(row, &mut genres)).collect()
+}
