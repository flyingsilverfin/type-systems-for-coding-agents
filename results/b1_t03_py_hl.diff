+def history(member_id: str, loans: list[Loan]) -> list[str]:
+    ordered = sorted(loans, key=lambda loan: (loan.borrowed, loan.id))
+    lines = [f"history {member_id}: {len(ordered)} loans"]
+    for loan in ordered:
+        returned = loan.returned.isoformat() if loan.returned is not None else "open"
+        lines.append(
+            f"  {loan.id} {loan.isbn} borrowed {loan.borrowed.isoformat()} due {loan.due.isoformat()} returned {returned}"
+        )
+    return lines
+
