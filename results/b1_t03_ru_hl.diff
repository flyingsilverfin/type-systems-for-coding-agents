+pub fn history(member_id: &str, loans: &[Loan]) -> Vec<String> {
+    let mut ordered: Vec<&Loan> = loans.iter().collect();
+    ordered.sort_by(|a, b| (a.borrowed, &a.id).cmp(&(b.borrowed, &b.id)));
+    let mut lines = vec![format!("history {}: {} loans", member_id, ordered.len())];
+    lines.extend(ordered.iter().map(|loan| {
+        format!(
+            "  {} {} borrowed {} due {} returned {}",
+            loan.id,
+            loan.isbn,
+            loan.borrowed.format("%Y-%m-%d"),
+            loan.due.format("%Y-%m-%d"),
+            loan.returned.map_or_else(|| "open".to_owned(), |r| r.format("%Y-%m-%d").to_string()),
+        )
+    }));
+    lines
+}
