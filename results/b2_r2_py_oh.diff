diff --git a/app/lending/memberid.py b/app/lending/memberid.py
new file mode 100644
index 0000000..1581df3
--- /dev/null
+++ b/app/lending/memberid.py
@@ -0,0 +1,22 @@
+"""Member ids: stored in the database as integers, shown to users as `M` followed by (at least) three digits."""
+from __future__ import annotations
+
+import re
+from typing import Optional
+
+_PATTERN = re.compile(r"M([0-9]+)")
+_MAX = 2**63 - 1  # TypeDB integers are signed 64-bit
+
+
+def parse(text: str) -> Optional[int]:
+    """The numeric key for a user-facing id like `M042`, or None if `text` is not `M` followed by digits."""
+    match = _PATTERN.fullmatch(text)
+    if match is None:
+        return None
+    value = int(match.group(1))
+    return value if value <= _MAX else None
+
+
+def format(member_id: int) -> str:
+    """The user-facing form of a numeric member id, e.g. 7 -> `M007`."""
+    return f"M{member_id:03d}"
