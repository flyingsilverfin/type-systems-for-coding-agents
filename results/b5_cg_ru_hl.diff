+/// The genres of a book: `genre` may hold several separated by `;`. Sorted, without duplicates.
+fn genres(record: &Record) -> Vec<String> {
+    let mut genres: Vec<String> = optional(record, "genre")
+        .into_iter()
+        .flat_map(|text| text.split(';'))
+        .map(str::trim)
+        .filter(|genre| !genre.is_empty())
+        .map(str::to_owned)
+        .collect();
+    genres.sort();
+    genres.dedup();
+    genres
+}
