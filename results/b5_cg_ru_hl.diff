+/// One result row as a book: its listing columns with the row's genre (if any), and its subtitle when
+/// `with_subtitle` is set.
+fn read_book(row: &ConceptRow, with_subtitle: bool) -> Result<(BookSummary, Option<String>)> {
+    let summary = BookSummary {
+        isbn: row.get("isbn")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("isbn", "string"))?
+            .to_owned(),
+        title: row.get("title")?
+            .and_then(Concept::try_get_string)
+            .ok_or_else(|| AppError::column("title", "string"))?
+            .to_owned(),
+        year: row.get("year")?.and_then(Concept::try_get_integer).ok_or_else(|| AppError::column("year", "integer"))?,
+        genres: optional_string(row, "genre")?.into_iter().collect(),
+    };
+    let subtitle = if with_subtitle { optional_string(row, "subtitle")? } else { None };
+    Ok((summary, subtitle))
+}
+
+/// Merge the rows of each book into one entry, collecting its genres (sorted, without duplicates).
+fn merge_books(rows: Vec<(BookSummary, Option<String>)>) -> Vec<(BookSummary, Option<String>)> {
+    let mut merged: BTreeMap<String, (BookSummary, Option<String>)> = BTreeMap::new();
+    for (book, subtitle) in rows {
+        match merged.entry(book.isbn.clone()) {
+            Entry::Vacant(entry) => {
+                entry.insert((book, subtitle));
+            }
+            Entry::Occupied(mut entry) => {
+                let (existing, existing_subtitle) = entry.get_mut();
+                existing.genres.extend(book.genres);
+                if existing_subtitle.is_none() {
+                    *existing_subtitle = subtitle;
+                }
+            }
+        }
+    }
+    merged
+        .into_values()
+        .map(|(mut book, subtitle)| {
+            book.genres.sort();
+            book.genres.dedup();
+            (book, subtitle)
+        })
+        .collect()
+}
+
+/// The books of a query whose rows hold one genre each, one entry per book.
+fn list_books(rows: &[ConceptRow], with_subtitle: bool) -> Result<Vec<(BookSummary, Option<String>)>> {
+    let read = rows.iter().map(|row| read_book(row, with_subtitle)).collect::<Result<Vec<_>>>()?;
+    Ok(merge_books(read))
+}
