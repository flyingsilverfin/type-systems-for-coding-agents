+/// A string column of a row, if the row has a value for it.
+fn optional_string(row: &ConceptRow, var: &str) -> Result<Option<String>> {
+    row.get(var)?
+        .map(|concept| concept.try_get_string().map(str::to_owned).ok_or_else(|| AppError::column(var, "string")))
