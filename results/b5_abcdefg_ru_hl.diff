index 6e6e2b9..43b1a25 100644
--- a/app/src/repo/mod.rs
+++ b/app/src/repo/mod.rs
@@ -1,8 +1,81 @@
 //! Read-side queries: one function per CLI command, each with its own TypeQL query.
 //!
-//! Commands whose output depends on loan status return `model::Loan`, so the status rules live in one
-//! place; the others return small purpose-built rows holding only the columns the command needs.
-//! Column values are extracted inline with `ConceptRow::get` and the `Concept::try_get_*` accessors.
+//! Optional attributes are read in `try` blocks, and multi-valued attributes (genre, email) are read by
+//! separate queries and merged here, so that no row is repeated. Commands whose output depends on loan
+//! status return `model::Loan`, read by `loans_matching`, so the status rules live in one place.
+use chrono::NaiveDate;
+use typedb_driver::answer::ConceptRow;
+
+use crate::{
+    db::Db,
+    error::{AppError, Result},
+    model::Loan,
+};
+
 pub mod books;
 pub mod loans;
 pub mod members;
+
+pub fn text(row: &ConceptRow, var: &str) -> Result<String> {
+    opt_text(row, var)?.ok_or_else(|| AppError::column(var, "string"))
+}
+
+pub fn opt_text(row: &ConceptRow, var: &str) -> Result<Option<String>> {
+    row.get(var)?
+        .map(|concept| concept.try_get_string().map(str::to_owned).ok_or_else(|| AppError::column(var, "string")))
+        .transpose()
+}
+
+pub fn int(row: &ConceptRow, var: &str) -> Result<i64> {
+    opt_int(row, var)?.ok_or_else(|| AppError::column(var, "integer"))
+}
+
+pub fn opt_int(row: &ConceptRow, var: &str) -> Result<Option<i64>> {
+    row.get(var)?
+        .map(|concept| concept.try_get_integer().ok_or_else(|| AppError::column(var, "integer")))
+        .transpose()
+}
+
+pub fn date(row: &ConceptRow, var: &str) -> Result<NaiveDate> {
+    opt_date(row, var)?.ok_or_else(|| AppError::column(var, "date"))
+}
+
+pub fn opt_date(row: &ConceptRow, var: &str) -> Result<Option<NaiveDate>> {
+    row.get(var)?
+        .map(|concept| concept.try_get_date().ok_or_else(|| AppError::column(var, "date")))
+        .transpose()
+}
+
+/// Every loan matching `anchor`, a TypeQL statement list that binds `$m` (borrower) and `$b` (item).
+/// An empty anchor matches every loan.
+pub fn loans_matching(db: &Db, anchor: &str) -> Result<Vec<Loan>> {
+    let rows = db.read_rows(&format!(
+        "
+        match
+          {anchor}
+          $l isa loan, links (borrower: $m, item: $b), has loan-id $loan_id, has borrowed $borrowed;
+          $m has member-id $member_id;
+          $b has isbn $isbn;
+          try {{ $l has due $due; }};
+          try {{ $l has renewed $renewed; }};
+          try {{ $l has returned $returned; }};
+          try {{ $l has lost $lost; }};
+          try {{ $l has fee-cents $fee; }};
+        "
+    ))?;
+    rows.iter()
+        .map(|row| {
+            Ok(Loan {
+                id: text(row, "loan_id")?,
+                member_id: text(row, "member_id")?,
+                isbn: text(row, "isbn")?,
+                borrowed: date(row, "borrowed")?,
+                due: opt_date(row, "due")?,
+                renewed: opt_date(row, "renewed")?,
+                returned: opt_date(row, "returned")?,
+                lost: opt_date(row, "lost")?,
+                fee_cents: opt_int(row, "fee")?,
+            })
+        })
+        .collect()
+}
