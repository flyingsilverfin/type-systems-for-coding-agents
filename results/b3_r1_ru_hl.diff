+/// The state of a loan: exactly one of these cases holds.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum LoanStatus {
+    Open,
+    Returned(NaiveDate),
+    Lost(NaiveDate),
+}
+
+impl LoanStatus {
+    /// Derive the status from the stored return and lost dates.
+    /// A lost loan counts as lost even if it also carries a return date.
+    pub fn from_dates(returned: Option<NaiveDate>, lost: Option<NaiveDate>) -> Self {
+        match (lost, returned) {
+            (Some(lost), _) => Self::Lost(lost),
+            (None, Some(returned)) => Self::Returned(returned),
+            (None, None) => Self::Open,
+        }
+    }
+}
+
