diff --git a/app/src/repo/mod.rs b/app/src/repo/mod.rs
index 6e6e2b9..f36ca81 100644
--- a/app/src/repo/mod.rs
+++ b/app/src/repo/mod.rs
@@ -3,6 +3,26 @@
 //! Commands whose output depends on loan status return `model::Loan`, so the status rules live in one
 //! place; the others return small purpose-built rows holding only the columns the command needs.
 //! Column values are extracted inline with `ConceptRow::get` and the `Concept::try_get_*` accessors.
+use typedb_driver::answer::ConceptRow;
+
+use crate::{
+    error::{AppError, Result},
+    model::LoanStatus,
+};
+
 pub mod books;
 pub mod loans;
 pub mod members;
+
+/// The status of a loan from its optional `returned` and `lost` columns of the given row.
+pub fn loan_status(row: &ConceptRow) -> Result<LoanStatus> {
+    let returned = row
+        .get("returned")?
+        .map(|concept| concept.try_get_date().ok_or_else(|| AppError::column("returned", "date")))
+        .transpose()?;
+    let lost = row
+        .get("lost")?
+        .map(|concept| concept.try_get_date().ok_or_else(|| AppError::column("lost", "date")))
+        .transpose()?;
+    Ok(LoanStatus::from_dates(returned, lost))
+}
