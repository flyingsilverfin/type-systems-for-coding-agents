 def monthly(borrowed: list[date]) -> list[str]:
-    counts = Counter(f"{day.year:04d}-{day.month:02d}" for day in borrowed)
-    return [f"{month}: {count}" for month, count in sorted(counts.items())]
+    if not borrowed:
